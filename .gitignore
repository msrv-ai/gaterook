# Internal AI work. Anchor this rule so Java src/**/ai/ packages remain visible.
/ai/
/.claude/

# Local editor and operating-system state.
.DS_Store
.idea/
*.iml

# Ignore accidental local dependencies and build output.
node_modules/
target/
.flattened-pom.xml
/dist/
/build/
/coverage/
/desktop/dist/
/desktop/stage/
/desktop/release/
/ui/dist/
/ui/.angular/
playwright-report/
test-results/
npm-debug.log*

# Local runtime state and secrets. Commit only sanitized examples.
.env
.env.*
!.env.example
!.env.*.example
/.dev/
/.local/
/.secrets/
/signing-private/
/logs/

# Do not add a blanket dist/ rule: the design kit may version generated assets.

# Additional build output and local runtime data.
out-tsc/
.angular/
*.tsbuildinfo
/design/site-dist/
/desktop/.dev/
*.log

# Public disposable test credentials; generated keys remain local.
!/test-services/.env
/test-services/run/
