<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Connector SPI (ARCHITECTURE.md §3). One jar inside the native core and inside the plugin host.
  Only the JDK and Jackson 3 (provided: the core and the host bring it, the host parent-first).
  No Spring, Reactor, SDKs, SLF4J or OpenTelemetry here.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.msrv.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>0.4.0-SNAPSHOT</version>
  </parent>

  <artifactId>connector-api</artifactId>
  <!-- Versioned on its own, = ApiVersion.CURRENT; plugins declare requires.connectorApi against it. -->
  <version>1.0.0</version>
  <name>MCP Gateway · Connector API</name>

  <dependencies>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- The published API compiles without a single warning (ARCHITECTURE.md §3). -->
          <compilerArgs combine.children="append">
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
