{
  "name": "gaterook-ui",
  "version": "0.4.4",
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "ng": "ng",
    "sync-kit": "node ../scripts/sync-kit-assets.mjs",
    "prestart": "npm run sync-kit",
    "start": "ng serve",
    "prebuild": "node ../scripts/sync-version.mjs && npm run sync-kit",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run sync-kit",
    "test": "ng test --watch=false",
    "dev": "node scripts/dev.mjs",
    "compare": "node scripts/compare.mjs"
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lucide/angular": "1.49.0",
    "@gaterook/design-kit": "file:../design",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "playwright-core": "1.56.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
