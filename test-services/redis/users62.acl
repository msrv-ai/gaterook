user default on >default-pass ~* &* +@all
user ro on >ro-pass ~* resetchannels -@all +@read +@connection -@dangerous +client|setname +client|id -dump -xread -lolwut
user rokeys on >rokeys-pass ~cache:* resetchannels -@all +@read +@connection -@dangerous +client|setname +client|id -dump -xread -lolwut
user rw on >rw-pass ~* &* +@all -@dangerous
