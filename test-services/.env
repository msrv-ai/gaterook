GW_ELASTICSEARCH_TAG=9.5.5
GW_ELASTICSEARCH_PORT=55201
GW_MOTO_TAG=5.2.4
GW_MOTO_PORT=55500

# Vault (core secret stores, the SSH CA of connectors/ssh)
GW_VAULT_TAG=2.2.1
