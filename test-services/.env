# Test-only values of test-services/docker-compose.yml: image tags, ports on 127.0.0.1 and the passwords the
# integration tests know. Compose reads this file for its ${…}; the tests read the same file (TestServices), so a
# port or a password changes here and nowhere else. Nothing here is a real secret.

GW_ALPINE_TAG=3.22

# SQL (connectors/sql, app e2e, the database engine of Vault)
GW_PG_TAG=16.13
GW_PG_PORT=55432
GW_PG_PASSWORD=postgres-pw-0001
GW_MYSQL_TAG=8.4.10
GW_MYSQL_PORT=55306
GW_MARIADB_TAG=11.4.5
GW_MARIADB_PORT=55307
GW_ORACLE_TAG=23.26.3-slim@sha256:6d61d267a3b978c24c5ac1790e62e927416a0aec446bd86e4b3a1527562757bd
GW_ORACLE_PORT=55521
GW_ORACLE_SERVICE=FREEPDB1
GW_ORACLE_USER=GATEROOK_TEST
GW_ORACLE_PASSWORD=oracle-pw-0001
GW_ORACLE_ADMIN_PASSWORD=oracle-admin-pw-0001
GW_SQLSERVER_TAG=2022-CU23-ubuntu-22.04
GW_SQLSERVER_PORT=55433
GW_SQLSERVER_PASSWORD=SqlServer-fixture-pw-0001

# MongoDB (connectors/mongodb, app e2e): 8.x with access control, without it, with TLS; 7.0 and 9.0 of the matrix.
# 8.2, not the 8.0.23 the ITs start natively: 8.0.x refuses Linux kernels 6.19 and newer (SERVER-121912), and the
# kernel of Docker Desktop's VM is 7.0.
GW_MONGO_TAG=8.2.4
GW_MONGO_PORT=55017
GW_MONGO_OPEN_PORT=55018
GW_MONGO_TLS_PORT=55019
GW_MONGO7_TAG=7.0.45
GW_MONGO7_PORT=55070
GW_MONGO9_TAG=9.0.4
GW_MONGO9_PORT=55090
GW_MONGO_ROOT_PASSWORD=root-pw-7a1c2e9b

# Redis (connectors/redis, app e2e): a primary with TLS, its replica, an open default user, a cluster node, 6.2
GW_REDIS_TAG=7.0.15
GW_REDIS_PORT=55379
GW_REDIS_TLS_PORT=55380
GW_REDIS_REPLICA_PORT=55381
GW_REDIS_OPEN_PORT=55382
GW_REDIS_CLUSTER_PORT=55383
GW_REDIS62_TAG=6.2.11
GW_REDIS62_PORT=55362
GW_REDIS62_TLS_PORT=55363

# Logs (connectors/logs) and AWS (connectors/aws, connectors/cloud-auth)
