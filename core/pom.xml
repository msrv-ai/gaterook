<?xml version="1.0" encoding="UTF-8"?>
<!--
  The gateway core: a Spring Boot application (ai.msrv.gaterook.core.GatewayApplication) cut into Spring Modulith
  modules (ARCHITECTURE.md §2.2). It reaches connectors only through Connector beans; it never imports a connector
  implementation. Assembled with every connector by `app`, which owns repackaging and the native image.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.msrv.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>0.4.0-SNAPSHOT</version>
  </parent>

  <artifactId>core</artifactId>
  <name>MCP Gateway · Core</name>

  <dependencies>
    <!-- ── Our modules ── -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connector-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>plugin-protocol</artifactId>
    </dependency>
    <!-- Egress guard for the catalog, plugin downloads and OpenAPI by URL. -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connectors-support</artifactId>
    </dependency>
    <!-- GCP Secret Manager and AWS Secrets Manager credentials. -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connectors-cloud-auth</artifactId>
    </dependency>

    <!-- ── Spring Boot ── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- Micrometer + OpenTelemetry; OTLP export stays off until Settings sets an address (A17). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <!-- Module boundaries at run time need only the annotations; verification (spring-modulith-core) is test-only. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
    </dependency>

    <!-- ── Gateway database (decision 3, A10): Spring Data JPA + Hibernate on SQLite, schema by Flyway ── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- SQLite support is inside flyway-core. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- SQLiteDialect, resolved from JDBC metadata: never named in configuration (report 15 §9 rule 15). -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>

    <!-- ── Libraries of the core modules (ARCHITECTURE.md §1) ── -->
    <!-- secrets: envelope encryption (A14); protobuf-java comes with it at the Boot-managed 4.36.2. -->
    <dependency>
      <groupId>com.google.crypto.tink</groupId>
      <artifactId>tink</artifactId>
    </dependency>
    <!-- secrets.store: AWS Secrets Manager (S1); url-connection-client only. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>secretsmanager</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>
    <!-- audit.export (K5): SigV4 for S3 PUTs sent with java.net.http; the signer only, no S3 SDK. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>http-auth-aws</artifactId>
    </dependency>
    <!-- mcp: arguments against inputSchema; connections: config against configSchema. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>
    <!-- invocation: CircuitBreaker, semaphore Bulkhead and RateLimiter, used programmatically (A15). -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-bulkhead</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-ratelimiter</artifactId>
    </dependency>
    <!-- clients: Codex config.toml blocks (TomlBlockEditor) and the "What will change" diff (DiffService). -->
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-toml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.java-diff-utils</groupId>
      <artifactId>java-diff-utils</artifactId>
    </dependency>

    <!-- ── Tests ── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The reference MCP client of the protocol tests (report 01). -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- HeldCertificate: the HTTPS document servers of the OAuth tests (CIMD over TLS, K3). -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp-tls</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Build order only, as in app: PluginSupervisorIT launches plugin-host.jar and the Jira and fixture plugin JARs it
      finds by path. Without these the reactor built the core first, and its ITs ran against a stale host from an
      earlier build (or skipped on a fresh checkout). Never on this module's classpath.
    -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>plugin-host</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>plugins-jira-service-desk</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>plugins-test-fixtures</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Only core.properties is filtered: the version the ready line reports (CoreBuild). -->
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
      <!--
        The Node bridge Claude Desktop's extensions carry (clients.internal.McpbBuilder): one source, bridge/gw-bridge.mjs
        of the npm workspace, copied in as a resource so that the native core builds a .mcpb without the bundle.
      -->
      <resource>
        <directory>${project.basedir}/../bridge</directory>
        <includes>
          <include>gw-bridge.mjs</include>
        </includes>
        <targetPath>ai/msrv/gaterook/core/clients/bridge</targetPath>
      </resource>
    </resources>
    <plugins>
      <!--
        Build-time bytecode enhancement of ALL entities, the only build plugin of core (ARCHITECTURE.md §4). In native,
        Hibernate runs with BytecodeProvider 'none' and can't generate HibernateProxy classes (report 15 §9 rule 13).
        Lazy initialization and dirty tracking are on by default in 7.x.
      -->
      <plugin>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>enhance</goal></goals>
            <configuration>
              <enableAssociationManagement>false</enableAssociationManagement>
              <enableExtendedEnhancement>false</enableExtendedEnhancement>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <!-- Everything but the scheduler stress test, which needs a JVM of its own. -->
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/SqliteConcurrencyTest.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <!--
            Report 14 §9.2 on purpose: two carriers, so that a carrier pinned in SQLite's native lock wait is felt. The
            property is read once per JVM, when the first virtual thread starts.
          -->
          <execution>
            <id>sqlite-concurrency</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <includes>
                <include>**/SqliteConcurrencyTest.java</include>
              </includes>
              <argLine>--enable-native-access=ALL-UNNAMED -Djdk.virtualThreadScheduler.parallelism=2</argLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- *IT: integration tests that start the whole core (PlatformIT). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      FFM metadata of NativeOs (prctl) only where prctl exists: native images for macOS x64 have no FFM at all
      (report 15 §4), and the other systems have no prctl (ARCHITECTURE.md §2.4).
    -->
    <profile>
      <id>linux-ffm</id>
      <activation>
        <os><name>Linux</name></os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>linux-native-metadata</id>
                <goals><goal>add-resource</goal></goals>
                <configuration>
                  <resources>
                    <resource>
                      <directory>src/main/native-linux</directory>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
