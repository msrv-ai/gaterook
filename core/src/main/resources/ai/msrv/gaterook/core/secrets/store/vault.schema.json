{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-gateway:store/vault",
  "title": "HashiCorp Vault",
  "description": "Or OpenBao, its open-source fork",
  "type": "object",
  "additionalProperties": false,
  "required": ["address", "auth"],
  "properties": {
    "address": {
      "type": "string",
      "title": "Address",
      "maxLength": 512,
      "examples": ["https://vault.acme.internal"],
      "description": "https:// (plain http only to this computer)"
    },
    "namespace": {
      "type": "string",
      "title": "Namespace",
      "maxLength": 256,
      "description": "X-Vault-Namespace (Vault Enterprise, HCP, OpenBao namespaces)"
    },
    "caCert": {
      "type": "string",
      "title": "CA certificate",
      "maxLength": 20000,
      "x-widget": "textarea",
      "description": "PEM of a private CA. Empty: the system's certificates."
    },
    "auth": {
      "type": "object",
      "title": "Sign-in",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "enum": ["approle", "token", "cli-token"],
          "default": "approle",
          "x-enumTitles": ["AppRole (recommended)", "Token", "Your vault login on this computer"]
        },
        "mount": {"type": "string", "default": "approle", "maxLength": 128},
        "roleId": {"type": "string", "maxLength": 128, "title": "Role ID"},
        "secretId": {
          "type": "string",
          "title": "Secret ID",
          "writeOnly": true,
          "x-gateway-secret": "value",
          "format": "password"
        },
        "token": {
          "type": "string",
          "title": "Token",
          "writeOnly": true,
          "x-gateway-secret": "value",
          "format": "password"
        },
        "file": {"type": "string", "default": "~/.vault-token", "maxLength": 1024}
      },
      "allOf": [
        {"if": {"properties": {"method": {"const": "approle"}}}, "then": {"required": ["roleId"]}}
      ]
    },
    "renewIncrement": {"type": "string", "default": "1h", "pattern": "^[1-9][0-9]{0,4}[smh]$", "title": "Renew the token by"},
    "cacheTtlSeconds": {
      "type": "integer",
      "default": 60,
      "minimum": 0,
      "maximum": 300,
      "x-unit": "s",
      "title": "Keep a resolved value",
      "description": "Prod connections use at most 15 s."
    },
    "useSystemProxy": {"type": "boolean", "default": false, "title": "Use the system proxy"}
  }
}
