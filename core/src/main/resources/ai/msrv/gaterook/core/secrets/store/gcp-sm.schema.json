{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-gateway:store/gcp-sm",
  "title": "GCP Secret Manager",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "credentials"],
  "properties": {
    "project": {
      "type": "string",
      "title": "Project",
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
      "examples": ["acme-stage"]
    },
    "credentials": {
      "type": "object",
      "title": "Sign-in",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "enum": ["adc", "serviceAccountKey"],
          "default": "adc",
          "x-enumTitles": ["Your gcloud credentials on this computer", "A service account key"]
        },
        "impersonate": {
          "type": "string",
          "title": "Impersonate",
          "maxLength": 256,
          "examples": ["gw-secrets@acme-stage.iam.gserviceaccount.com"],
          "description": "A service account with roles/secretmanager.secretAccessor. Tokens last 15 min."
        },
        "delegates": {"type": "array", "maxItems": 5, "items": {"type": "string", "maxLength": 256}},
        "lifetimeSeconds": {"type": "integer", "default": 900, "minimum": 300, "maximum": 3600},
        "quotaProject": {"type": "string", "maxLength": 64},
        "serviceAccountKey": {
          "type": "string",
          "title": "Service account key (JSON)",
          "writeOnly": true,
          "x-gateway-secret": "value",
          "x-widget": "textarea"
        }
      }
    },
    "cacheTtlSeconds": {
      "type": "integer",
      "default": 60,
      "minimum": 0,
      "maximum": 300,
      "x-unit": "s",
      "title": "Keep a resolved value",
      "description": "Prod connections use at most 15 s."
    }
  }
}
