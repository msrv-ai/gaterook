{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-gateway:store/aws-sm",
  "title": "AWS Secrets Manager",
  "description": "Read with AssumeRole and an ExternalId",
  "type": "object",
  "additionalProperties": false,
  "required": ["region", "credentials"],
  "properties": {
    "region": {
      "type": "string",
      "title": "Region",
      "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]+$",
      "examples": ["eu-central-1"]
    },
    "credentials": {
      "type": "object",
      "title": "Sign-in",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "enum": ["accessKey", "profile"],
          "default": "accessKey",
          "x-enumTitles": ["An access key stored here", "A profile of this computer (~/.aws)"]
        },
        "accessKeyId": {"type": "string", "title": "Access key ID", "pattern": "^(AKIA|ASIA)[A-Z0-9]{16}$", "x-not-secret": true},
        "secretAccessKey": {
          "type": "string",
          "title": "Secret access key",
          "writeOnly": true,
          "x-gateway-secret": "value",
          "format": "password"
        },
        "profile": {"type": "string", "maxLength": 128},
        "roleArn": {
          "type": "string",
          "title": "Role to assume",
          "maxLength": 2048,
          "examples": ["arn:aws:iam::123456789012:role/gw-secrets-read"],
          "description": "A role that can read the secrets. Each session may read only the references."
        },
        "externalId": {
          "type": "string",
          "title": "ExternalId",
          "maxLength": 1224,
          "x-generated": true,
          "description": "Add it to the role's trust policy as sts:ExternalId. It isn't a secret."
        },
        "sessionSeconds": {"type": "integer", "default": 900, "minimum": 900, "maximum": 3600}
      }
    },
    "cacheTtlSeconds": {
      "type": "integer",
      "default": 60,
      "minimum": 0,
      "maximum": 300,
      "x-unit": "s",
      "title": "Keep a resolved value",
      "description": "Prod connections use at most 15 s."
    }
  }
}
