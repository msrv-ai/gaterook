{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-gateway:store/azure-kv",
  "title": "Azure Key Vault",
  "description": "Read with a service principal of Entra ID",
  "type": "object",
  "additionalProperties": false,
  "required": ["vault", "tenantId", "credentials"],
  "properties": {
    "vault": {
      "type": "string",
      "title": "Key vault",
      "minLength": 3,
      "maxLength": 24,
      "pattern": "^[a-z](-?[a-z0-9])+$",
      "examples": ["acme-kv"],
      "description": "The vault's name, as azure-kv://<vault>/<secret> references name it. A store reads one vault."
    },
    "cloud": {
      "title": "Cloud",
      "enum": ["AzureCloud", "AzureUSGovernment", "AzureChinaCloud"],
      "default": "AzureCloud",
      "x-enumTitles": ["Azure", "Azure Government", "Azure China (21Vianet)"]
    },
    "tenantId": {
      "type": "string",
      "title": "Tenant (directory) ID",
      "maxLength": 253,
      "pattern": "^([0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}|[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+)$",
      "examples": ["contoso.onmicrosoft.com"],
      "description": "The directory of the vault and the service principal: a GUID or a domain."
    },
    "credentials": {
      "type": "object",
      "title": "Sign-in",
      "additionalProperties": false,
      "required": ["source", "clientId"],
      "properties": {
        "source": {
          "title": "Sign in with",
          "enum": ["clientSecret", "clientCertificate"],
          "default": "clientSecret",
          "x-enumTitles": ["Service principal with a client secret", "Service principal with a certificate"]
        },
        "clientId": {
          "type": "string",
          "title": "Application (client) ID",
          "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
          "examples": ["0a1b2c3d-1111-4222-8333-444455556666"],
          "description": "An app registration with Key Vault Secrets User on the vault or on the secrets it reads."
        },
        "clientSecret": {
          "type": "string",
          "title": "Client secret",
          "writeOnly": true,
          "x-gateway-secret": "value",
          "format": "password"
        },
        "certificate": {
          "type": "string",
          "title": "Certificate and private key (PEM)",
          "writeOnly": true,
          "x-gateway-secret": "value",
          "x-widget": "textarea",
          "maxLength": 20000,
          "description": "An RSA private key (unencrypted PKCS#8 or PKCS#1) and its certificate."
        }
      }
    },
    "cacheTtlSeconds": {
      "type": "integer",
      "default": 60,
      "minimum": 0,
      "maximum": 300,
      "x-unit": "s",
      "title": "Keep a resolved value",
      "description": "Prod connections use at most 15 s."
    }
  }
}
