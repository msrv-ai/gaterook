# Codex settings, edited by hand
model = "gpt-5.5-codex" # the default

[profiles.work]
approval_policy = "on-request"

# servers below
[mcp_servers.github]
url = "https://api.githubcopilot.com/mcp/"
[mcp_servers.github.env]
GITHUB_TOKEN_SOURCE = "keychain"

# >>> GateRook · gateway-dev · managed entry: Disconnect in GateRook removes it
[mcp_servers.gateway-dev]
url = "http://127.0.0.1:7465/mcp/dev"
http_headers_helper = "~/.gaterook/bin/gw-bridge headers --endpoint dev --grant gr_cx7q2lmaabcd"
default_tools_approval_mode = "writes"
startup_timeout_sec = 20
tool_timeout_sec = 60
# <<< GateRook · gateway-dev
