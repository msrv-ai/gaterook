<?xml version="1.0" encoding="UTF-8"?>
<!--
  Jira Service Desk, the example plugin of reports 11 §3.3 and 16 §8: a Java plugin that runs in the plugin host, not in
  the core. connector-api and Jackson are provided by the host (parent-first); HTTP goes through java.net.http behind the
  host's guarded ExecContext.egress(). No other library.

  One code base, two releases: 1.2.0 (five tools) and 1.3.0 (+ jira_request_sla, no new hosts). A release is the
  compiled classes plus that release's mcp-gateway-plugin.json (src/main/releases/<version>/): the connector reads its
  manifest from its own JAR, so each JAR serves exactly the tools it declares. The JARs are attached with the
  classifiers 1.2.0 and 1.3.0; plugin-it installs them side by side. Built by step K4.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.msrv.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>0.4.1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>plugins-jira-service-desk</artifactId>
  <name>GateRook · Plugins · Jira Service Desk</name>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <!-- The host serves both parent-first: a plugin never ships its own copy (the installer refuses one). -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connector-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The manifests must parse as the core and the host parse them, and match what the code serves. -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>plugin-protocol</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>release-1.2.0</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/release-1.2.0</outputDirectory>
              <resources>
                <resource><directory>${project.build.outputDirectory}</directory></resource>
                <resource><directory>src/main/releases/1.2.0</directory></resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>release-1.3.0</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/release-1.3.0</outputDirectory>
              <resources>
                <resource><directory>${project.build.outputDirectory}</directory></resource>
                <resource><directory>src/main/releases/1.3.0</directory></resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>release-1.2.0</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>1.2.0</classifier>
              <classesDirectory>${project.build.directory}/release-1.2.0</classesDirectory>
            </configuration>
          </execution>
          <execution>
            <id>release-1.3.0</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>1.3.0</classifier>
              <classesDirectory>${project.build.directory}/release-1.3.0</classesDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
