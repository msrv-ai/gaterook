<?xml version="1.0" encoding="UTF-8"?>
<!--
  Microsoft Access, a plugin of the signed catalog (docs/access.md): one .accdb or .mdb file on this computer, read
  through UCanAccess with the file opened read-only and HSQLDB in a read-only transaction, and changed only by an
  approved statement on a separate copy that writes the file. connector-api and Jackson are provided by the host
  (parent-first).

  The plugin is one JAR (the installer refuses nested jars and anything over 50 MB), so UCanAccess, Jackcess and
  HSQLDB are shaded into it unmodified, with their licenses (META-INF/LICENSE.txt, NOTICE.txt, hsqldb_lic.txt,
  hypersonic_lic.txt and META-INF/LICENSE-Access-plugin.txt, which says which is whose).

  The JAR is the catalog's package gw-msaccess-1.0.0.jar: the manifest (src/main/resources/mcp-gateway-plugin.json)
  says 1.0.0, and the fixed outputTimestamp makes the build reproducible. AccessPluginHostIT loads that JAR in a real
  plugin host after `package`.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.msrv.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>plugins-access</artifactId>
  <name>GateRook · Plugins · Microsoft Access</name>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- Reproducible JAR: the catalog signs its SHA-256. -->
    <project.build.outputTimestamp>2026-11-11T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <dependencies>
    <!-- The host serves both parent-first: a plugin never ships its own copy (the installer refuses one). -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connector-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Shaded into the plugin JAR, unmodified, with Jackcess and HSQLDB. -->
    <dependency>
      <groupId>io.github.spannm</groupId>
      <artifactId>ucanaccess</artifactId>
    </dependency>
    <!-- The HSQLDB UCanAccess 5.3.0 is built and tested with, over the version Spring Boot's BOM manages. -->
    <dependency>
      <groupId>org.hsqldb</groupId>
      <artifactId>hsqldb</artifactId>
      <version>2.7.4</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The manifest must parse as the core and the host parse it; the host IT speaks GPP/1 to a real host. -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>plugin-protocol</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Build order only: the host must be packaged before AccessPluginHostIT copies its jar. A pom-type dependency with
      every transitive excluded adds the reactor edge without putting PF4J on any classpath of this module.
    -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>plugin-host</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <finalName>gw-msaccess-1.0.0</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration combine.self="override">
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>io.github.spannm:ucanaccess</include>
                  <include>io.github.spannm:jackcess</include>
                  <include>org.hsqldb:hsqldb</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>io.github.spannm:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>org.hsqldb:hsqldb</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- UCanAccess and HSQLDB both register a JDBC driver. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The plugin host AccessPluginHostIT starts, copied next to the tests (never on a classpath here). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-plugin-host</id>
            <phase>pre-integration-test</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>ai.msrv.gaterook</groupId>
                  <artifactId>plugin-host</artifactId>
                  <version>${project.version}</version>
                  <destFileName>plugin-host.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/plugin-host</outputDirectory>
              <excludeTransitive>true</excludeTransitive>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- After package: the release JAR in a real plugin host (AccessPluginHostIT). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <gateway.pluginHostJar>${project.build.directory}/plugin-host/plugin-host.jar</gateway.pluginHostJar>
            <gateway.accessJar>${project.build.directory}/${project.build.finalName}.jar</gateway.accessJar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
