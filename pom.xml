  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all,-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- FFM (NativeOs, SQLite JNI) without warnings; same flag as the native image. -->
            <argLine>--enable-native-access=ALL-UNNAMED ${test.jvm.extra}</argLine>
            <excludedGroups>${it.excludedGroups}</excludedGroups>
            <systemPropertyVariables>
              <gateway.it.services>${it.services}</gateway.it.services>
              <gateway.build.version>${revision}</gateway.build.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <argLine>--enable-native-access=ALL-UNNAMED ${test.jvm.extra}</argLine>
            <excludedGroups>${it.excludedGroups}</excludedGroups>
            <systemPropertyVariables>
              <gateway.it.services>${it.services}</gateway.it.services>
              <gateway.build.version>${revision}</gateway.build.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.hibernate.orm</groupId>
          <artifactId>hibernate-maven-plugin</artifactId>
          <version>${hibernate.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <dependencies>
            <dependency>
              <groupId>org.codehaus.mojo</groupId>
              <artifactId>extra-enforcer-rules</artifactId>
              <version>${extra-enforcer-rules.version}</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Resolve CI-friendly versions in installed POMs without changing dependency or build metadata. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.8.0</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals><goal>flatten</goal></goals>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <phase>clean</phase>
            <goals><goal>clean</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!--
        Dependency bans (ARCHITECTURE.md §2.1). Each ban is its own execution so that the one module that
        legitimately needs a banned artifact switches off exactly that execution (phase none) and nothing else.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>ban-libraries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>Banned dependency: see ARCHITECTURE.md §1 (A9, A11) and §2.1.</message>
                  <excludes>
                    <!-- Jackson 3 only (A9). The AWS SDK shades its own copy, which is a different artifact. -->
                    <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                    <exclude>org.springframework.boot:spring-boot-jackson2</exclude>
                    <!-- ArchUnit-based verification is a test concern; the runtime only needs spring-modulith-api. -->
                    <exclude>org.springframework.modulith:spring-modulith-core:*:*:compile</exclude>
                    <exclude>org.springframework.modulith:spring-modulith-core:*:*:runtime</exclude>
                    <exclude>org.springframework.modulith:spring-modulith-core:*:*:provided</exclude>
                    <!-- AWS SDK HTTP clients other than url-connection-client. -->
                    <exclude>software.amazon.awssdk:apache5-client</exclude>
                    <exclude>software.amazon.awssdk:apache-client</exclude>
                    <exclude>software.amazon.awssdk:netty-nio-client</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
          <execution>
            <!-- PF4J loads classes at run time: it lives in the plugin host process, never in the native core. -->
            <id>ban-pf4j</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>PF4J belongs to plugin-host only (ARCHITECTURE.md A12).</message>
                  <excludes>
                    <exclude>org.pf4j:pf4j</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
          <execution>
            <!-- sshd-common registers a FileSystemProvider that breaks the native build: use ai.msrv.gaterook:sshd-nofs. -->
            <id>ban-sshd</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>Use ai.msrv.gaterook:sshd-nofs instead of org.apache.sshd (ARCHITECTURE.md A23, report 15 §4).</message>
                  <excludes>
                    <exclude>org.apache.sshd:sshd-core</exclude>
                    <exclude>org.apache.sshd:sshd-common</exclude>
                    <exclude>org.apache.sshd:sshd-sftp</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The servers of test-services/docker-compose.yml (scripts/test-services.sh up; test-services/README.md) instead of
      the ones the ITs start themselves, and the ITs that need them: MySQL/MariaDB, Oracle, MongoDB, logs, Vault, moto. The
      modules connectors/redis and connectors/ssh turn on their own switches with the same profile.
    -->
    <profile>
      <id>services</id>
      <properties>
        <it.services>${maven.multiModuleProjectDirectory}/test-services</it.services>
        <it.tag.mysql>__enabled-mysql-it</it.tag.mysql>
        <it.tag.mongo>__enabled-mongo-it</it.tag.mongo>
        <it.tag.logs>__enabled-logs-it</it.tag.logs>
        <it.tag.vault>__enabled-vault-it</it.tag.vault>
        <it.tag.cloud>__enabled-cloud-it</it.tag.cloud>
      </properties>
    </profile>
    <!-- Heavy integration tests (ARCHITECTURE.md §2.4); downloads go to ~/.cache/mcp-gateway-test/. -->
    <profile>
      <id>mysql-it</id>
      <properties><it.tag.mysql>__enabled-mysql-it</it.tag.mysql></properties>
    </profile>
    <profile>
      <id>sqlserver-it</id>
      <properties><it.tag.sqlserver>__enabled-sqlserver-it</it.tag.sqlserver></properties>
    </profile>
    <profile>
      <id>mongo-it</id>
      <properties><it.tag.mongo>__enabled-mongo-it</it.tag.mongo></properties>
    </profile>
    <profile>
      <id>logs-it</id>
      <properties><it.tag.logs>__enabled-logs-it</it.tag.logs></properties>
    </profile>
    <profile>
      <id>kube-api</id>
      <properties><it.tag.kube>__enabled-kube-api</it.tag.kube></properties>
    </profile>
    <profile>
      <id>vault-it</id>
      <properties><it.tag.vault>__enabled-vault-it</it.tag.vault></properties>
    </profile>
    <profile>
      <!-- STS against moto 5.2.4 (report 09 §8): a venv at ~/.cache/mcp-gateway-test/moto-5.2.4, see README. -->
      <id>cloud-it</id>
      <properties><it.tag.cloud>__enabled-cloud-it</it.tag.cloud></properties>
    </profile>
    <profile>
      <!-- Real network: cloudflared up to a hostname (K3). -->
      <id>network</id>
      <properties><it.tag.network>__enabled-network</it.tag.network></properties>
    </profile>
    <profile>
      <!--
        Reference Node MCP clients (M1.5): @modelcontextprotocol/client 2.3.1, inspector 2.12.0, conformance 0.1.16 from
        core/src/test/node/package-lock.json into ~/.cache/mcp-gateway-test/node-clients; Node 24 (MCP_NODE).
      -->
      <id>mcp-clients</id>
      <properties><it.tag.mcpclients>__enabled-mcp-clients</it.tag.mcpclients></properties>
    </profile>
    <profile>
      <!--
        Real OpenAPI descriptions (report 10 §8.5): Stripe spec3.json and GitHub api.github.com.json at pinned commits,
        SHA-256 checked, into ~/.cache/mcp-gateway-test/openapi (C9).
      -->
      <id>openapi-corpus</id>
      <properties><it.tag.openapi>__enabled-openapi-corpus</it.tag.openapi></properties>
    </profile>
    <profile>
      <!--
        Real external MCP servers (C10): @modelcontextprotocol/server-github 2025.4.8 and server-everything 2.0.0 from
        app/src/test/node/mcp-servers/package-lock.json into ~/.cache/mcp-gateway-test/c10-mcp-servers; Node 24
        (MCP_NODE, else the PATH).
      -->
      <id>mcp-servers</id>
      <properties><it.tag.mcpservers>__enabled-mcp-servers</it.tag.mcpservers></properties>
    </profile>
  </profiles>
</project>
