<?xml version="1.0" encoding="UTF-8"?>
<!--
  GateRook: the Maven reactor.

  Every library version lives here and only here (ARCHITECTURE.md §1): the Spring Boot BOM rewrites transitive
  versions in `app`, so a pin in a module pom would silently not reach the e2e tests and the native image.
  Module poms declare dependencies without versions.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>ai.msrv.gaterook</groupId>
  <artifactId>mcp-gateway</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>GateRook</name>
  <description>Desktop gateway through which AI agents use infrastructure via MCP without seeing secrets.</description>

  <modules>
    <module>connector-api</module>
    <module>plugin-protocol</module>
    <module>third-party/sshd-nofs</module>
    <module>connectors/support</module>
    <module>connectors/cloud-auth</module>
    <module>connectors/sql</module>
    <module>connectors/mongodb</module>
    <module>connectors/redis</module>
    <module>connectors/ssh</module>
    <module>connectors/logs</module>
    <module>connectors/kubernetes</module>
    <module>connectors/gcp</module>
    <module>connectors/aws</module>
    <module>connectors/http</module>
    <module>connectors/mcp-server</module>
    <module>core</module>
    <module>app</module>
    <module>plugin-host</module>
    <module>plugins/jira-service-desk</module>
    <module>plugins/test-fixtures</module>
    <module>plugins/clickhouse</module>
    <module>plugins/rabbitmq</module>
    <module>plugin-it</module>
    <module>bridge-cli</module>
  </modules>

  <properties>
    <!-- Application version: change this value for the next release. -->
    <revision>0.4.4</revision>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- The SPI is versioned on its own: plugins declare requires.connectorApi against it (ApiVersion.CURRENT). -->
    <connector-api.version>1.0.0</connector-api.version>

    <!-- Overrides of versions the Spring Boot BOM manages (reports 05, 07, 09). -->
    <mongodb.version>5.13.0</mongodb.version>
    <jedis.version>8.0.2</jedis.version>
    <!-- Jedis 8.0.2 and google-auth 1.54.0 need gson 2.14.0; Boot 4.1.2 would pin 2.13.2. -->
    <gson.version>2.14.0</gson.version>

    <!-- Versions the Spring Boot BOM does not manage. -->
    <spring-modulith.version>2.1.2</spring-modulith.version>
    <resilience4j.version>2.4.0</resilience4j.version>
    <aws-sdk.version>2.57.3</aws-sdk.version>
    <fabric8.version>8.0.0</fabric8.version>
    <okhttp.version>5.5.1</okhttp.version>
    <google-auth.version>1.54.0</google-auth.version>
    <mssql-jdbc.version>13.6.0.jre11</mssql-jdbc.version>
    <jsqlparser.version>5.4</jsqlparser.version>
    <oracle-jdbc.version>23.26.4.0.0</oracle-jdbc.version>
    <sshd.version>2.20.0</sshd.version>
    <re2j.version>1.8</re2j.version>
    <bouncycastle.version>1.86</bouncycastle.version>
    <java-diff-utils.version>4.17</java-diff-utils.version>
    <!-- Google client libraries disagree among themselves (google-auth 1.54.0, google-http-client 2.2.0, Tink):
         one version each for app's dependencyConvergence, the highest any of them asks for. -->
    <guava.version>33.6.0-jre</guava.version>
    <error_prone_annotations.version>2.50.0</error_prone_annotations.version>
    <j2objc-annotations.version>3.1</j2objc-annotations.version>
    <!-- One pin for everybody: Fabric8 8.0.0 brings 3.1.1, the OpenAPI loader of report 10 was checked on 3.0.1. -->
    <snakeyaml-engine.version>3.1.1</snakeyaml-engine.version>
    <!-- Held at 3.0.6 until the RefCheck CI gate passes on 3.0.8 (3.0.7+ are built against Jackson 3.2). -->
    <json-schema-validator.version>3.0.6</json-schema-validator.version>
    <tink.version>1.24.0</tink.version>
    <mcp-sdk.version>2.1.0</mcp-sdk.version>
    <pf4j.version>3.16.0</pf4j.version>
    <archunit.version>1.4.2</archunit.version>
    <flapdoodle-mongo.version>5.0.0</flapdoodle-mongo.version>
    <extra-enforcer-rules.version>1.12.1</extra-enforcer-rules.version>

    <!-- Only `app` has a main class; libraries keep an empty Main-Class out of their manifests. -->
    <start-class/>
    <!-- `spring-boot:run` is meant for `app` only (ARCHITECTURE.md §2.4). -->
    <spring-boot.run.skip>true</spring-boot.run.skip>

    <!--
      Heavy integration tests are JUnit 5 tags, excluded by default and switched on by a profile of the same name.
      Each profile replaces its own tag with a name no test uses, so several profiles compose.
    -->
    <it.tag.mysql>mysql-it</it.tag.mysql>
    <it.tag.sqlserver>sqlserver-it</it.tag.sqlserver>
    <it.tag.mongo>mongo-it</it.tag.mongo>
    <it.tag.logs>logs-it</it.tag.logs>
    <it.tag.kube>kube-api</it.tag.kube>
    <it.tag.vault>vault-it</it.tag.vault>
    <it.tag.cloud>cloud-it</it.tag.cloud>
    <it.tag.network>network</it.tag.network>
    <it.tag.mcpclients>mcp-clients</it.tag.mcpclients>
    <it.tag.openapi>openapi-corpus</it.tag.openapi>
    <it.tag.mcpservers>mcp-servers</it.tag.mcpservers>
    <!-- The folder of test-services/docker-compose.yml when the ITs use its servers (-Pservices), else empty. -->
    <it.services></it.services>
    <!-- Extra JVM options of the test forks: the tracing agent of the nightly metadata report (native.yml). -->
    <test.jvm.extra></test.jvm.extra>
    <it.excludedGroups>${it.tag.mysql},${it.tag.sqlserver},${it.tag.mongo},${it.tag.logs},${it.tag.kube},${it.tag.vault},${it.tag.cloud},${it.tag.network},${it.tag.mcpclients},${it.tag.openapi},${it.tag.mcpservers}</it.excludedGroups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- ── Our own modules ───────────────────────────────────────────────────────────────────────────── -->
      <dependency>
