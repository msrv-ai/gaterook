{
  "id": "msaccess",
  "version": "1.1.0",
  "name": "Microsoft Access",
  "provider": "GateRook",
  "license": "Apache-2.0",
  "description": "A Microsoft Access .accdb or .mdb file on this computer: read-only queries with row and time limits; changes wait for approval.",
  "moduleClass": "ai.msrv.gaterook.connectors.access.AccessModule",
  "requires": {
    "gateway": ">=0.9.2 & <1.0.0",
    "connectorApi": ">=1.2.0 & <2.0.0",
    "javaModules": [
      "java.sql",
      "java.logging"
    ]
  },
  "access": {
    "hosts": [],
    "commands": [],
    "files": [
      "chosen in each connection"
    ]
  },
  "resources": {
    "maxHeapMb": 512,
    "maxMetaspaceMb": 128,
    "maxInFlight": 8
  }
}
