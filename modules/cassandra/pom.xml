<?xml version="1.0" encoding="UTF-8"?>
<!--
  Apache Cassandra as a connector module (docs/connector-delivery.md): the package GateRook downloads when a
  connection needs the connector. It is connectors/cassandra with its driver stack and the shared connector code in
  one JAR, plus the manifest that ModuleManifests writes from the connector itself.

  The host provides the connector API, Jackson and SLF4J: they are never part of the package. The module's version is
  module.json's and has nothing to do with the application's: it changes only when the package does
  (scripts/modules.mjs). The reactor's fixed outputTimestamp makes the build reproducible, so the same sources give
  the same bytes and the SHA-256 the signed list pins can be compared with a rebuild.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.msrv.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>modules-cassandra</artifactId>
  <name>GateRook · Modules · Apache Cassandra</name>

  <properties>
    <!-- The version of module.json; scripts/modules.mjs keeps the two equal. -->
    <module.version>1.0.0</module.version>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connectors-cassandra</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Served by the module host, parent-first: never part of the package. -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connector-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Build time only: ModuleManifests writes the manifest from the module's connectors. -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>plugin-protocol</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>cassandra-${module.version}</finalName>
    <resources>
      <!-- The versions in the package's license notes are the build's own. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- The manifest, written from the connectors the module class gives: it can't disagree with the code. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>module-manifest</id>
            <phase>process-classes</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <java classname="ai.msrv.gaterook.plugin.protocol.ModuleManifests" fork="true" failonerror="true"
                      classpathref="maven.compile.classpath">
                  <arg value="${project.basedir}/module.json"/>
                  <arg value="${project.build.outputDirectory}/mcp-gateway-plugin.json"/>
                </java>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration combine.self="override">
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
                <!-- The connector's registration as a Spring bean is the compiled-in delivery's. -->
                <filter>
                  <artifact>ai.msrv.gaterook:connectors-cassandra</artifact>
                  <excludes>
                    <exclude>ai/msrv/gaterook/connectors/cassandra/boot/**</exclude>
                    <exclude>META-INF/spring/**</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <!--
                The libraries' own license and notice files stay as they are; META-INF/LICENSE-Cassandra-module.txt
                says which is whose.
              -->
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
