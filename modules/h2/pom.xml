<?xml version="1.0" encoding="UTF-8"?>
<!--
  H2 as a connector module (docs/connector-delivery.md, docs/h2.md): an H2 database server over H2's TCP protocol.
  The H2 client opens its own sockets, which the module host's TCP gate lets reach only the connection's host and
  port (access.tcp of module.json), under the environment's policy. Reads are checked statements that are always
  rolled back; a change runs one approved statement. H2 exists only as a module: its code lives here, runs in a
  module host and is never compiled into the core. The connector API and Jackson are provided by the host
  (parent-first).

  The package is one JAR, so H2's unmodified classes are shaded into it, with H2's license (MPL 2.0 or EPL 1.0) and
  where its source is (META-INF/NOTICE-H2.txt).

  The package is h2-<version>.jar. Its manifest is written by ModuleManifests from module.json and from what the
  connector says of itself (src/main/resources/connectors/h2/connector.json). The module's version is module.json's
  and changes only when the package does (scripts/modules.mjs); the reactor's fixed outputTimestamp makes the build
  reproducible, so the SHA-256 the signed list pins can be compared with a rebuild. H2ModuleHostIT loads that
  JAR in a real module host after `package`.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.msrv.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>modules-h2</artifactId>
  <name>GateRook · Modules · H2</name>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- The version of module.json; scripts/modules.mjs keeps the two equal. -->
    <module.version>1.1.0</module.version>
  </properties>

  <dependencies>
    <!-- The host serves both parent-first: a plugin never ships its own copy (the installer refuses one). -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connector-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Shaded into the plugin JAR, unmodified. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Build time and tests only, never part of the package: ModuleManifests writes the manifest from the module's
      connector, and the tests read it as the core and the host do.
    -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>plugin-protocol</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Build order only: the host must be packaged before H2ModuleHostIT copies its jar. A pom-type dependency with
      every transitive excluded adds the reactor edge without putting PF4J on any classpath of this module.
    -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>plugin-host</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <finalName>h2-${module.version}</finalName>
    <resources>
      <!-- The connector's version and the versions in the package's license notes are the build's own. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- The manifest, written from the connector the module class gives: it can't disagree with the code. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>module-manifest</id>
            <phase>process-classes</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <java classname="ai.msrv.gaterook.plugin.protocol.ModuleManifests" fork="true" failonerror="true"
                      classpathref="maven.compile.classpath">
                  <arg value="${project.basedir}/module.json"/>
                  <arg value="${project.build.outputDirectory}/mcp-gateway-plugin.json"/>
                </java>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration combine.self="override">
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>com.h2database:h2</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>com.h2database:h2</artifact>
                  <includes>
                    <include>org/h2/**</include>
                    <include>META-INF/services/java.sql.Driver</include>
                  </includes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The module host H2ModuleHostIT starts, copied next to the tests (never on a classpath here). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-plugin-host</id>
            <phase>pre-integration-test</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>ai.msrv.gaterook</groupId>
                  <artifactId>plugin-host</artifactId>
                  <version>${project.version}</version>
                  <destFileName>plugin-host.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/plugin-host</outputDirectory>
              <excludeTransitive>true</excludeTransitive>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- After package: the release JAR in a real plugin host (H2ModuleHostIT). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <gateway.pluginHostJar>${project.build.directory}/plugin-host/plugin-host.jar</gateway.pluginHostJar>
            <gateway.h2Jar>${project.build.directory}/${project.build.finalName}.jar</gateway.h2Jar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
