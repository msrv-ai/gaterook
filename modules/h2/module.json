{
  "id": "h2",
  "version": "1.1.0",
  "name": "H2",
  "provider": "GateRook",
  "license": "Apache-2.0",
  "description": "An H2 database server: checked read-only queries with row and time limits, always rolled back; changes wait for approval.",
  "moduleClass": "ai.msrv.gaterook.connectors.h2.H2Module",
  "requires": {
    "gateway": ">=0.9.2 & <1.0.0",
    "connectorApi": ">=1.2.0 & <2.0.0",
    "javaModules": [
      "java.sql"
    ]
  },
  "access": {
    "hosts": [],
    "commands": [],
    "files": [],
    "tcp": [
      "{connection.host}:{connection.port}"
    ]
  },
  "resources": {
    "maxHeapMb": 192,
    "maxMetaspaceMb": 128,
    "maxInFlight": 8
  }
}
