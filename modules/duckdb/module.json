{
  "id": "duckdb",
  "version": "1.1.0",
  "name": "DuckDB",
  "provider": "GateRook",
  "license": "Apache-2.0",
  "description": "A DuckDB database file on this computer: read-only queries with row, memory and time limits; changes wait for approval.",
  "moduleClass": "ai.msrv.gaterook.connectors.duckdb.DuckDbModule",
  "requires": {
    "gateway": ">=0.9.2 & <1.0.0",
    "connectorApi": ">=1.2.0 & <2.0.0",
    "javaModules": [
      "java.sql"
    ]
  },
  "access": {
    "hosts": [],
    "commands": [],
    "files": [
      "chosen in each connection"
    ]
  },
  "resources": {
    "maxHeapMb": 256,
    "maxMetaspaceMb": 128,
    "maxInFlight": 8
  }
}
