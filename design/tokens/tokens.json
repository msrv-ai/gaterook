{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "GateRook design tokens. DTCG format, single source of truth. Colour tokens carry the light value in $value and the other modes in $extensions[\"gw.modes\"] (dark, light-hc, dark-hc). A missing -hc value inherits the base value of the same scheme. Run `npm run build` to regenerate tokens/tokens.css and scss/_tokens.scss. Never edit those by hand.",

  "color": {
    "bg": {
      "canvas":   { "$type": "color", "$value": "#F5F6F8", "$extensions": { "gw.modes": { "dark": "#0B0D12" } }, "$description": "App background behind everything: titlebar, page area." },
      "sidebar":  { "$type": "color", "$value": "#EEF0F3", "$extensions": { "gw.modes": { "dark": "#0E1116" } }, "$description": "Sidebar navigation column." },
      "surface":  { "$type": "color", "$value": "#FFFFFF", "$extensions": { "gw.modes": { "dark": "#12151C" } }, "$description": "Cards, panels, tables, inputs on canvas." },
      "raised":   { "$type": "color", "$value": "#F0F2F5", "$extensions": { "gw.modes": { "dark": "#181C25" } }, "$description": "Secondary fill inside a surface: table header, hovered row, neutral button." },
      "sunken":   { "$type": "color", "$value": "#F6F7F9", "$extensions": { "gw.modes": { "dark": "#0E1116" } }, "$description": "Wells inside a surface: code blocks, config previews, input fields in dark." },
      "field":    { "$type": "color", "$value": "#FFFFFF", "$extensions": { "gw.modes": { "dark": "#0E1116" } }, "$description": "Fill of text inputs, selects, textareas: recessed in dark, white in light." },
      "overlay":  { "$type": "color", "$value": "#FFFFFF", "$extensions": { "gw.modes": { "dark": "#1F2430" } }, "$description": "Menus, popovers, dialogs, drawers, toasts." },
      "hover":    { "$type": "color", "$value": "rgba(17,20,26,.05)", "$extensions": { "gw.modes": { "dark": "rgba(255,255,255,.05)" } }, "$description": "Translucent hover wash for ghost items on any surface." },
      "active":   { "$type": "color", "$value": "rgba(17,20,26,.09)", "$extensions": { "gw.modes": { "dark": "rgba(255,255,255,.09)" } }, "$description": "Pressed / current ghost item." },
      "selected": { "$type": "color", "$value": "#EDEAFC", "$extensions": { "gw.modes": { "dark": "#201E3D" } }, "$description": "Selected row, current nav item. Always paired with a second cue (bar, weight, check)." },
      "inverse":  { "$type": "color", "$value": "#11141A", "$extensions": { "gw.modes": { "dark": "#E7E9EE" } }, "$description": "Tooltip, kbd hint chip." },
      "backdrop": { "$type": "color", "$value": "rgba(10,12,16,.48)", "$extensions": { "gw.modes": { "dark": "rgba(0,0,0,.64)" } }, "$description": "Scrim under modal dialogs and drawers." }
    },

    "text": {
      "primary":     { "$type": "color", "$value": "#11141A", "$extensions": { "gw.modes": { "dark": "#E7E9EE" } }, "$description": "Default text and headings." },
      "secondary":   { "$type": "color", "$value": "#454C59", "$extensions": { "gw.modes": { "dark": "#AEB4C0", "light-hc": "#2B3039", "dark-hc": "#D3D7DF" } }, "$description": "Descriptions, reading text, table cells that are not the key." },
      "muted":       { "$type": "color", "$value": "#5B6270", "$extensions": { "gw.modes": { "dark": "#8E95A3", "light-hc": "#3B414D", "dark-hc": "#BCC2CD" } }, "$description": "Labels, meta, timestamps, column headers. AA on every surface." },
      "placeholder": { "$type": "color", "$value": "#656C7A", "$extensions": { "gw.modes": { "dark": "#858C9A", "light-hc": "#454C59", "dark-hc": "#AEB4C0" } }, "$description": "Input placeholder. It is text: 4.5:1 on input and raised fills." },
      "disabled":    { "$type": "color", "$value": "#9AA0AB", "$extensions": { "gw.modes": { "dark": "#5C6270", "light-hc": "#6B7280", "dark-hc": "#858C9A" } }, "$description": "Disabled control text (exempt from 4.5:1, never used for information)." },
      "inverse":     { "$type": "color", "$value": "#FFFFFF", "$extensions": { "gw.modes": { "dark": "#11141A" } }, "$description": "Text on bg.inverse." },
      "link":        { "$type": "color", "$value": "#5B47E0", "$extensions": { "gw.modes": { "dark": "#A393FF", "light-hc": "#3F2CC4", "dark-hc": "#C2B8FF" } }, "$description": "Inline links. Underlined in running text." },
      "on-solid":    { "$type": "color", "$value": "#FFFFFF", "$description": "Text and icons on brand / success / danger / info / neutral solids." }
    },

    "border": {
      "subtle":  { "$type": "color", "$value": "#E9EBEF", "$extensions": { "gw.modes": { "dark": "#1E222B", "light-hc": "#B4BAC4", "dark-hc": "#3A4050" } }, "$description": "Dividers inside a surface (rows, sections)." },
      "default": { "$type": "color", "$value": "#DDE1E7", "$extensions": { "gw.modes": { "dark": "#272C37", "light-hc": "#8A919E", "dark-hc": "#596072" } }, "$description": "Card and panel outline." },
      "strong":  { "$type": "color", "$value": "#C5CBD4", "$extensions": { "gw.modes": { "dark": "#363C4A", "light-hc": "#6B7280", "dark-hc": "#7A8193" } }, "$description": "Emphasised outline: secondary button, segmented control, kbd." },
      "input":   { "$type": "color", "$value": "#7D8491", "$extensions": { "gw.modes": { "dark": "#6E7586", "light-hc": "#4A5160", "dark-hc": "#9AA1AE" } }, "$description": "Form control boundary. 3:1 against its fill (WCAG 1.4.11)." },
      "focus":   { "$type": "color", "$value": "#5B47E0", "$extensions": { "gw.modes": { "dark": "#A393FF", "light-hc": "#2E1FA8", "dark-hc": "#D1C9FF" } }, "$description": "Focus ring. 3:1 against every surface." }
    },

    "brand": {
      "fg":           { "$type": "color", "$value": "#5B47E0", "$extensions": { "gw.modes": { "dark": "#A393FF", "light-hc": "#3F2CC4", "dark-hc": "#C2B8FF" } }, "$description": "Brand text and icons: active nav icon, selected tab text, links." },
      "subtle":       { "$type": "color", "$value": "#EDEAFC", "$extensions": { "gw.modes": { "dark": "#201E3D" } }, "$description": "Brand tint: selected item, brand badge." },
      "border":       { "$type": "color", "$value": "#C9C0FA", "$extensions": { "gw.modes": { "dark": "#3E3680", "light-hc": "#5B47E0", "dark-hc": "#A393FF" } } },
      "solid":        { "$type": "color", "$value": "#6C56EE", "$description": "Gate violet. Primary button, switch on, checked box, progress. Same value in both schemes: white text 5.0:1, 3:1 or more against every dark surface incl. overlay." },
      "solid-hover":  { "$type": "color", "$value": "#5B47E0", "$description": "Hover darkens in both schemes: lighter violets drop white text under 4.5:1." },
      "solid-active": { "$type": "color", "$value": "#4F3CCB" },
      "on-solid":     { "$type": "color", "$value": "#FFFFFF" }
    },

    "success": {
      "fg":          { "$type": "color", "$value": "#0B6E43", "$extensions": { "gw.modes": { "dark": "#4CD38A", "light-hc": "#075233", "dark-hc": "#7EE0A8" } }, "$description": "Allowed, approved, healthy, connected." },
      "subtle":      { "$type": "color", "$value": "#E3F4E9", "$extensions": { "gw.modes": { "dark": "#132A21" } } },
      "border":      { "$type": "color", "$value": "#A7DCBC", "$extensions": { "gw.modes": { "dark": "#1F5A3D", "light-hc": "#0B6E43", "dark-hc": "#4CD38A" } } },
      "solid":       { "$type": "color", "$value": "#15803D", "$description": "Approve button. White text 5.0:1." },
      "solid-hover": { "$type": "color", "$value": "#116B33" },
      "on-solid":    { "$type": "color", "$value": "#FFFFFF" }
    },

    "warning": {
      "fg":          { "$type": "color", "$value": "#8F5600", "$extensions": { "gw.modes": { "dark": "#F2B544", "light-hc": "#6B4000", "dark-hc": "#F7CB74" } }, "$description": "Needs a human: approval pending, degraded, expiring token." },
      "subtle":      { "$type": "color", "$value": "#FEF4E5", "$extensions": { "gw.modes": { "dark": "#33291A" } } },
      "border":      { "$type": "color", "$value": "#F2CF8F", "$extensions": { "gw.modes": { "dark": "#5E4A1E", "light-hc": "#8F5600", "dark-hc": "#F2B544" } } },
      "solid":       { "$type": "color", "$value": "#F5A524", "$description": "Amber fill. Dark text only (on-solid)." },
      "solid-hover": { "$type": "color", "$value": "#E09314" },
      "on-solid":    { "$type": "color", "$value": "#1A1300", "$description": "Text on the amber solid: 9:1." }
    },

    "danger": {
      "fg":          { "$type": "color", "$value": "#B42525", "$extensions": { "gw.modes": { "dark": "#FF7B7B", "light-hc": "#8A1717", "dark-hc": "#FFA3A3" } }, "$description": "Denied, rejected, failed, destructive, prod." },
      "subtle":      { "$type": "color", "$value": "#FBE7E9", "$extensions": { "gw.modes": { "dark": "#351D22" } } },
      "border":      { "$type": "color", "$value": "#F1B3B8", "$extensions": { "gw.modes": { "dark": "#6B2A30", "light-hc": "#B42525", "dark-hc": "#FF7B7B" } } },
      "solid":       { "$type": "color", "$value": "#C42B2B", "$description": "Deny / revoke / delete button. White text 5.6:1." },
      "solid-hover": { "$type": "color", "$value": "#A82222", "$extensions": { "gw.modes": { "dark": "#D63A3A" } } },
      "on-solid":    { "$type": "color", "$value": "#FFFFFF" }
    },

    "info": {
      "fg":          { "$type": "color", "$value": "#1957C6", "$extensions": { "gw.modes": { "dark": "#71A7FF", "light-hc": "#0F3F96", "dark-hc": "#9DC2FF" } }, "$description": "Read only, informational, running." },
      "subtle":      { "$type": "color", "$value": "#E6EEFD", "$extensions": { "gw.modes": { "dark": "#19263F" } } },
      "border":      { "$type": "color", "$value": "#B1C8F5", "$extensions": { "gw.modes": { "dark": "#2B4775", "light-hc": "#1957C6", "dark-hc": "#71A7FF" } } },
      "solid":       { "$type": "color", "$value": "#2563EB" },
      "solid-hover": { "$type": "color", "$value": "#1D4FC4" },
      "on-solid":    { "$type": "color", "$value": "#FFFFFF" }
    },

    "neutral": {
      "fg":          { "$type": "color", "$value": "#454C59", "$extensions": { "gw.modes": { "dark": "#AEB4C0", "light-hc": "#2B3039", "dark-hc": "#D3D7DF" } }, "$description": "Off, unknown, never run, expired." },
      "subtle":      { "$type": "color", "$value": "#EEF0F3", "$extensions": { "gw.modes": { "dark": "#1F2430" } } },
      "border":      { "$type": "color", "$value": "#D3D8DF", "$extensions": { "gw.modes": { "dark": "#363C4A", "light-hc": "#6B7280", "dark-hc": "#8E95A3" } } },
      "solid":       { "$type": "color", "$value": "#5B6270", "$extensions": { "gw.modes": { "dark": "#4A5160" } } },
      "solid-hover": { "$type": "color", "$value": "#4A5160", "$extensions": { "gw.modes": { "dark": "#565D6C" } } },
      "on-solid":    { "$type": "color", "$value": "#FFFFFF" }
    },

    "env": {
      "dev": {
        "fg":     { "$type": "color", "$value": "#096A75", "$extensions": { "gw.modes": { "dark": "#43C9D4", "light-hc": "#054E57", "dark-hc": "#7FDCE4" } }, "$description": "Development environment." },
        "subtle": { "$type": "color", "$value": "#E3F6F8", "$extensions": { "gw.modes": { "dark": "#122F37" } } },
        "border": { "$type": "color", "$value": "#9ED8DE", "$extensions": { "gw.modes": { "dark": "#1C5862", "light-hc": "#096A75", "dark-hc": "#43C9D4" } } },
        "solid":  { "$type": "color", "$value": "#0E7C86", "$extensions": { "gw.modes": { "dark": "#14B8C6" } }, "$description": "Env bar marker (non text)." }
      },
      "stage": {
        "fg":     { "$type": "color", "$value": "#A44A06", "$extensions": { "gw.modes": { "dark": "#FF9F57", "light-hc": "#7A3604", "dark-hc": "#FFBE8A" } }, "$description": "Staging environment." },
        "subtle": { "$type": "color", "$value": "#FEEEE3", "$extensions": { "gw.modes": { "dark": "#37241B" } } },
        "border": { "$type": "color", "$value": "#F4C29C", "$extensions": { "gw.modes": { "dark": "#6A3A1C", "light-hc": "#A44A06", "dark-hc": "#FF9F57" } } },
        "solid":  { "$type": "color", "$value": "#C2570C", "$extensions": { "gw.modes": { "dark": "#F97316" } } }
      },
      "prod": {
        "fg":     { "$type": "color", "$value": "#B42525", "$extensions": { "gw.modes": { "dark": "#FF7B7B", "light-hc": "#8A1717", "dark-hc": "#FFA3A3" } }, "$description": "Production. Same hue as danger on purpose: prod is where mistakes cost." },
        "subtle": { "$type": "color", "$value": "#FBE7E9", "$extensions": { "gw.modes": { "dark": "#351D22" } } },
        "border": { "$type": "color", "$value": "#F1B3B8", "$extensions": { "gw.modes": { "dark": "#6B2A30", "light-hc": "#B42525", "dark-hc": "#FF7B7B" } } },
        "solid":  { "$type": "color", "$value": "#C42B2B", "$extensions": { "gw.modes": { "dark": "#EF4444" } } }
      }
    },

    "code": {
      "bg":          { "$type": "color", "$value": "#F6F7F9", "$extensions": { "gw.modes": { "dark": "#0E1116" } }, "$description": "Code block, config preview, terminal output." },
      "text":        { "$type": "color", "$value": "#11141A", "$extensions": { "gw.modes": { "dark": "#E7E9EE" } } },
      "keyword":     { "$type": "color", "$value": "#6D28D9", "$extensions": { "gw.modes": { "dark": "#C4A7FF" } }, "$description": "SQL keywords, YAML anchors, booleans." },
      "string":      { "$type": "color", "$value": "#0B6E43", "$extensions": { "gw.modes": { "dark": "#7EE0A8" } } },
      "number":      { "$type": "color", "$value": "#A44A06", "$extensions": { "gw.modes": { "dark": "#FFB27A" } } },
      "comment":     { "$type": "color", "$value": "#636A78", "$extensions": { "gw.modes": { "dark": "#878E9D" } } },
      "function":    { "$type": "color", "$value": "#1957C6", "$extensions": { "gw.modes": { "dark": "#82B4FF" } } },
      "property":    { "$type": "color", "$value": "#096A75", "$extensions": { "gw.modes": { "dark": "#5FD3DD" } }, "$description": "JSON / YAML / TOML keys." },
      "punctuation": { "$type": "color", "$value": "#5B6270", "$extensions": { "gw.modes": { "dark": "#9AA1AE" } } },
      "secret":      { "$type": "color", "$value": "#9D174D", "$extensions": { "gw.modes": { "dark": "#F59BC4" } }, "$description": "Masked value placeholder in output: ‹masked›, ‹secret:ref›." }
    },

    "diff": {
      "add-bg":  { "$type": "color", "$value": "#E3F4E9", "$extensions": { "gw.modes": { "dark": "#13291F" } } },
      "add-fg":  { "$type": "color", "$value": "#0B6E43", "$extensions": { "gw.modes": { "dark": "#4CD38A" } }, "$description": "The + marker and gutter. Line text stays code.text." },
      "del-bg":  { "$type": "color", "$value": "#FBE7E9", "$extensions": { "gw.modes": { "dark": "#2E1A1E" } } },
      "del-fg":  { "$type": "color", "$value": "#B42525", "$extensions": { "gw.modes": { "dark": "#FF7B7B" } } },
      "hunk-bg": { "$type": "color", "$value": "#E6EEFD", "$extensions": { "gw.modes": { "dark": "#19263F" } } },
      "hunk-fg": { "$type": "color", "$value": "#1957C6", "$extensions": { "gw.modes": { "dark": "#71A7FF" } } }
    },

    "chart": {
      "1": { "$type": "color", "$value": "#6C56EE", "$extensions": { "gw.modes": { "dark": "#9D8CFF" } }, "$description": "Categorical series. Never the only carrier of meaning: pair with labels or patterns." },
      "2": { "$type": "color", "$value": "#0E7C86", "$extensions": { "gw.modes": { "dark": "#3CC8D4" } } },
      "3": { "$type": "color", "$value": "#C2570C", "$extensions": { "gw.modes": { "dark": "#FF9F57" } } },
      "4": { "$type": "color", "$value": "#2563EB", "$extensions": { "gw.modes": { "dark": "#71A7FF" } } },
      "5": { "$type": "color", "$value": "#BE185D", "$extensions": { "gw.modes": { "dark": "#F59BC4" } } },
      "6": { "$type": "color", "$value": "#15803D", "$extensions": { "gw.modes": { "dark": "#4CD38A" } } },
      "grid": { "$type": "color", "$value": "#E9EBEF", "$extensions": { "gw.modes": { "dark": "#1E222B" } } }
    }
  },

  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(16,20,28,.06)", "$extensions": { "gw.modes": { "dark": "0 1px 2px rgba(0,0,0,.40)" } }, "$description": "Resting card on canvas (light only reads it; dark relies on the border)." },
    "md": { "$type": "shadow", "$value": "0 4px 12px rgba(16,20,28,.08), 0 1px 3px rgba(16,20,28,.06)", "$extensions": { "gw.modes": { "dark": "0 6px 16px rgba(0,0,0,.45), 0 1px 3px rgba(0,0,0,.40)" } }, "$description": "Menus, popovers, toasts." },
    "lg": { "$type": "shadow", "$value": "0 16px 40px rgba(16,20,28,.16), 0 2px 6px rgba(16,20,28,.08)", "$extensions": { "gw.modes": { "dark": "0 20px 48px rgba(0,0,0,.60), 0 2px 6px rgba(0,0,0,.40)" } }, "$description": "Dialogs and drawers." }
  },

  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "\"Inter Variable\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif", "$description": "UI text. Inter: built for screens, tabular figures, Cyrillic." },
      "mono": { "$type": "fontFamily", "$value": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "$description": "Everything literal: tool names, slugs, hosts, SQL, commands, tokens, JSON." }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "2xs": { "$type": "dimension", "$value": "11px" },
      "xs":  { "$type": "dimension", "$value": "12px" },
      "sm":  { "$type": "dimension", "$value": "13px" },
      "md":  { "$type": "dimension", "$value": "14px" },
      "lg":  { "$type": "dimension", "$value": "16px" },
      "xl":  { "$type": "dimension", "$value": "18px" },
      "2xl": { "$type": "dimension", "$value": "22px" },
      "3xl": { "$type": "dimension", "$value": "28px" },
      "4xl": { "$type": "dimension", "$value": "36px" }
    },
    "line-height": {
      "xs":  { "$type": "dimension", "$value": "16px" },
      "sm":  { "$type": "dimension", "$value": "18px" },
      "md":  { "$type": "dimension", "$value": "20px" },
      "lg":  { "$type": "dimension", "$value": "24px" },
      "xl":  { "$type": "dimension", "$value": "28px" },
      "2xl": { "$type": "dimension", "$value": "36px" },
      "3xl": { "$type": "dimension", "$value": "44px" }
    },
    "tracking": {
      "tight":    { "$type": "dimension", "$value": "-0.011em", "$description": "Headings 18px and up (Inter's recommended negative tracking)." },
      "tighter":  { "$type": "dimension", "$value": "-0.022em", "$description": "Display sizes." },
      "normal":   { "$type": "dimension", "$value": "0" },
      "overline": { "$type": "dimension", "$value": "0.06em", "$description": "Uppercase overline labels only." }
    }
  },

  "type": {
    "$description": "Type ramp. Each role = size / line height / weight (+ tracking). Use @include gw-type(<role>) or the .gw-text-<role> utility. Never combine raw font sizes.",
    "display":   { "size": { "$type": "dimension", "$value": "{font.size.4xl}" }, "line": { "$type": "dimension", "$value": "{font.line-height.3xl}" }, "weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" }, "tracking": { "$type": "dimension", "$value": "{font.tracking.tighter}" } },
    "h1":        { "size": { "$type": "dimension", "$value": "{font.size.2xl}" }, "line": { "$type": "dimension", "$value": "{font.line-height.xl}" },  "weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" }, "tracking": { "$type": "dimension", "$value": "{font.tracking.tight}" } },
    "h2":        { "size": { "$type": "dimension", "$value": "{font.size.lg}" },  "line": { "$type": "dimension", "$value": "{font.line-height.lg}" },  "weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" }, "tracking": { "$type": "dimension", "$value": "{font.tracking.normal}" } },
    "h3":        { "size": { "$type": "dimension", "$value": "{font.size.md}" },  "line": { "$type": "dimension", "$value": "{font.line-height.md}" },  "weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" }, "tracking": { "$type": "dimension", "$value": "{font.tracking.normal}" } },
    "body":      { "size": { "$type": "dimension", "$value": "{font.size.md}" },  "line": { "$type": "dimension", "$value": "{font.line-height.md}" },  "weight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },  "tracking": { "$type": "dimension", "$value": "{font.tracking.normal}" } },
    "body-read": { "size": { "$type": "dimension", "$value": "{font.size.md}" },  "line": { "$type": "dimension", "$value": "22px" },                   "weight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },  "tracking": { "$type": "dimension", "$value": "{font.tracking.normal}" } },
    "ui":        { "size": { "$type": "dimension", "$value": "{font.size.sm}" },  "line": { "$type": "dimension", "$value": "{font.line-height.md}" },  "weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },   "tracking": { "$type": "dimension", "$value": "{font.tracking.normal}" } },
    "small":     { "size": { "$type": "dimension", "$value": "{font.size.sm}" },  "line": { "$type": "dimension", "$value": "{font.line-height.sm}" },  "weight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },  "tracking": { "$type": "dimension", "$value": "{font.tracking.normal}" } },
    "caption":   { "size": { "$type": "dimension", "$value": "{font.size.xs}" },  "line": { "$type": "dimension", "$value": "{font.line-height.xs}" },  "weight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },  "tracking": { "$type": "dimension", "$value": "{font.tracking.normal}" } },
    "overline":  { "size": { "$type": "dimension", "$value": "{font.size.2xs}" }, "line": { "$type": "dimension", "$value": "{font.line-height.xs}" },  "weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" }, "tracking": { "$type": "dimension", "$value": "{font.tracking.overline}" } },
    "code":      { "size": { "$type": "dimension", "$value": "{font.size.sm}" },  "line": { "$type": "dimension", "$value": "{font.line-height.md}" },  "weight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },  "tracking": { "$type": "dimension", "$value": "{font.tracking.normal}" } },
