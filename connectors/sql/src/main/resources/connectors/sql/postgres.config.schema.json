{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-card": {
    "description": "Read queries, schema, EXPLAIN. Writes wait for approval."
  },
  "additionalProperties": false,
  "required": [
    "connection",
    "credentials"
  ],
  "properties": {
    "connection": {
      "type": "object",
      "title": "Connection",
      "description": "Where the core reaches the database. It connects from this machine, so your VPN and hosts file apply.",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "type": "string",
          "title": "Host",
          "maxLength": 253,
          "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$|^\\d{1,3}(?:\\.\\d{1,3}){3}$|^\\[[0-9A-Fa-f:.]+\\]$"
        },
        "port": {
          "type": "integer",
          "title": "Port",
          "minimum": 1,
          "maximum": 65535,
          "default": 5432
        },
        "database": {
          "type": "string",
          "title": "Database",
          "pattern": "^[A-Za-z0-9_$.-]{1,63}$"
        },
        "databases": {
          "type": "array",
          "title": "Databases",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[^\\u0000]+$"
          },
          "description": "Only these databases are available through this connection."
        },
        "sslMode": {
          "type": "string",
          "title": "SSL mode",
          "enum": [
            "disable",
            "require",
            "verify-ca",
            "verify-full"
          ],
          "default": "verify-full",
          "x-enumTitles": [
            "Off (disable)",
            "Encrypt, don't verify (require)",
            "Verify the CA (verify-ca)",
            "Verify the CA and host name (verify-full)"
          ],
          "description": "verify-full checks the certificate and the host name. Lower it only for a database without TLS on a network you trust.",
          "x-section": "/advanced"
        },
        "caCertificate": {
          "type": "string",
          "title": "CA certificate (PEM)",
          "maxLength": 20000,
          "x-widget": "textarea",
          "description": "Only for a private CA. Empty: the system trust store.",
          "x-section": "/advanced"
        }
      }
    },
    "credentials": {
      "type": "object",
      "title": "Credentials",
      "x-gateway-secret": "login",
      "additionalProperties": false,
      "required": [
        "user"
      ],
      "properties": {
        "user": {
          "type": "string",
          "title": "User",
          "maxLength": 63,
          "description": "Use a user that can only read wherever you can. The test below shows what it may do."
        },
        "password": {
          "type": "string",
          "title": "Password",
          "description": "Leave empty when the server permits this user to connect without a password.",
          "writeOnly": true,
          "format": "password"
        }
      }
    },
    "advanced": {
      "type": "object",
      "title": "Advanced",
      "x-collapsed": true,
      "additionalProperties": false,
      "description": "Timeouts, pool and schema allowlist. Policies can tighten them per environment.",
      "properties": {
        "statementTimeoutMs": {
          "type": "integer",
          "title": "Statement timeout",
          "minimum": 100,
          "maximum": 600000,
          "x-unit": "ms",
          "x-stricter": "min",
          "description": "The database cancels slower statements. Empty: the environment policy."
        },
        "poolSize": {
          "type": "integer",
          "title": "Pool size",
          "minimum": 1,
          "maximum": 10,
          "default": 2,
          "x-unit": "connections"
        },
        "schemaAllowlist": {
          "type": "array",
          "title": "Schema allowlist",
          "uniqueItems": true,
          "maxItems": 100,
          "x-stricter": "intersect",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "allowedFunctions": {
          "type": "array",
          "title": "Functions reads may call",
          "uniqueItems": true,
          "maxItems": 200,
          "items": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z_][A-Za-z0-9_$]*(\\.[A-Za-z_][A-Za-z0-9_$]*)?$"
          },
          "description": "Your own functions that only read, as name or schema.name. Reads may call built-in functions; any other one waits for approval, and on prod it is refused."
        },
        "defaultSchema": {
          "type": "string",
          "title": "Default schema",
          "default": "public",
          "maxLength": 63
        },
        "connectTimeoutMs": {
          "type": "integer",
          "title": "Connect timeout",
          "minimum": 1000,
          "maximum": 30000,
          "default": 5000,
          "x-unit": "ms"
        },
        "discoveryDatabase": {
          "type": "string",
          "title": "Discovery database",
          "default": "postgres",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[^\\u0000]+$",
          "description": "Connect here to load the database list. Change this if your account cannot connect to postgres."
        }
      }
    }
  },
  "x-database-selection": {
    "path": "/connection/databases",
    "legacyPath": "/connection/database",
    "required": true
  }
}
