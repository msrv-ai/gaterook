{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "database": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "description": "A database selected for this connection. Required when the connection has more than one selected database."
    },
    "schema": {
      "type": "string",
      "maxLength": 128,
      "description": "Only this schema (MySQL: database)."
    },
    "pattern": {
      "type": "string",
      "maxLength": 128,
      "description": "Table name filter, SQL LIKE syntax: order%"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 500
    }
  }
}
