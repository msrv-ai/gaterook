pg | execute | dev | SAVEPOINT a | DENY forbidden
pg | execute | dev | ROLLBACK | DENY forbidden
pg | execute | dev | COPY orders FROM '/tmp/orders.csv' | DENY forbidden
pg | execute | dev | CREATE DATABASE other | DENY forbidden
pg | execute | dev | DROP DATABASE app | DENY forbidden
pg | execute | dev | ALTER SYSTEM SET work_mem = '1GB' | DENY forbidden
pg | execute | dev | SET ROLE postgres | DENY forbidden
pg | execute | dev | SET SESSION AUTHORIZATION postgres | DENY forbidden
pg | execute | dev | DISCARD ALL | DENY forbidden
pg | execute | dev | CHECKPOINT | DENY forbidden
pg | execute | dev | UPDATE orders SET status = 'x'; COMMIT | DENY forbidden
# The parser reads PURGE as a statement of its own; the gateway never runs it.
pg | execute | dev | PURGE TABLE orders | DENY forbidden
# What is refused everywhere stays refused where the gateway gives up on the text: an unclosed quote, a comment the
# server runs, a comment marker the parser would read differently, a statement the parser can't read.
pg | execute | dev | DISCARD ALL; SELECT 'unclosed | DENY forbidden
pg | execute | dev | /*+ Set(statement_timeout 0) */ SET statement_timeout = 0 | DENY forbidden
pg | execute | dev | SET statement_timeout = 0; SELECT 1 // x | DENY forbidden
pg | execute | dev | SELECT pg_terminate_backend(1) // x | DENY function-denied
pg | execute | dev | SELECT 1; SELECT pg_advisory_lock(1) // x | DENY function-denied
# Not analyzed, and nothing in it is refused everywhere: a person may approve it on dev.
pg | execute | dev | UPDATE orders SET a = 1 // x | MUTATION
