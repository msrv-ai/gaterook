# Routes of report 04 §3.5 and §6.1: dialect | tool | env | SQL | expected | options
# expected: READ, MUTATION or DENY <rule> (the rule id is <env>.sql.<rule>)
# options: allowlist=a,b (policy) · denied=f (policy deniedFunctions) · ddl=deny|allow (policy denyDdl)
#          allowed=f,s.g (connection allowedFunctions) · schemas=a,b (connection schemaAllowlist) · nodb (MySQL)
#
# ── PostgreSQL, sql_query: reads ──────────────────────────────────────────────────────────────────────────
pg | query | dev | SELECT 1 | READ
pg | query | dev | select id, status from orders where status = 'paid' order by id limit 10 | READ
pg | query | dev | WITH recent AS (SELECT * FROM orders WHERE created_at > now() - interval '1 day') SELECT count(*) FROM recent | READ
pg | query | dev | VALUES (1, 'a'), (2, 'b') | READ
pg | query | dev | TABLE orders | READ
pg | query | dev | EXPLAIN SELECT * FROM orders | READ
pg | query | dev | EXPLAIN ANALYZE SELECT * FROM orders | READ
pg | query | dev | EXPLAIN DELETE FROM orders | READ
pg | query | dev | SELECT o.id, c.email FROM orders o JOIN customers c ON c.id = o.customer_id | READ
pg | query | dev | SELECT * FROM orders WHERE id IN (SELECT order_id FROM order_items WHERE qty > 2) | READ
pg | query | dev | SELECT status, count(*) FROM orders GROUP BY status HAVING count(*) > 1 | READ
pg | query | dev | SELECT id, row_number() OVER (PARTITION BY status ORDER BY id) FROM orders | READ
pg | query | dev | SELECT coalesce(note, '') || ' ' || upper(status) FROM orders | READ
pg | query | dev | SELECT $$a;b$$ AS text | READ
# JSqlParser 5.4 reads $$…$$ but not every tagged dollar quote: fail closed.
pg | query | dev | SELECT $tag$ DROP TABLE orders; $tag$ AS text | DENY unparsed
pg | query | dev | SELECT 'a;b' AS x; | READ
pg | query | dev | SELECT /* ; DROP TABLE orders; */ 1 | READ
pg | query | dev | SELECT /* nested /* ; */ still a comment */ 1 | READ
pg | query | dev | SELECT 1 -- ; DROP TABLE orders | READ
pg | query | dev | SELECT jsonb_build_object('id', id) FROM orders | READ
pg | query | dev | SELECT pg_catalog.now() | READ
pg | query | dev | SELECT now()::date | READ
pg | query | dev | SELECT * FROM generate_series(1, 10) | READ
pg | query | dev | SELECT nextval('orders_id_seq') | READ
pg | query | dev | SELECT pg_sleep(10) | READ
pg | query | dev | SELECT count(*) FILTER (WHERE status = 'paid') FROM orders | READ
pg | query | dev | SELECT CASE WHEN total > 100 THEN 'big' ELSE 'small' END FROM orders | READ
pg | query | dev | SELECT * FROM orders ORDER BY id DESC LIMIT 5 OFFSET 10 | READ
pg | query | dev | SHOW search_path | READ
pg | query | dev | SELECT * FROM pg_stat_activity | READ
pg | query | dev | SELECT * FROM orders; -- trailing comment | READ
pg | query | dev | SELECT * FROM оrders | READ
pg | query | prod | SELECT id, status FROM orders | READ
pg | query | stage | SELECT id, status FROM orders | READ
