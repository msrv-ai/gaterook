#
# ── MySQL: calls in every expression position ──────────────────────────────────────────────────────────────
my | query | dev | SELECT GROUP_CONCAT(id ORDER BY LOAD_FILE('/etc/passwd')) FROM orders | DENY function-denied
my | query | dev | SELECT GROUP_CONCAT(LOAD_FILE('/etc/passwd')) FROM orders | DENY function-denied
my | query | dev | SELECT id FROM orders WHERE MATCH(note) AGAINST (LOAD_FILE('/etc/passwd')) | DENY function-denied
my | query | dev | SELECT count(*) OVER (PARTITION BY GET_LOCK('a', 10)) FROM orders | DENY function-denied
my | query | prod | SELECT count(*) OVER (PARTITION BY f_write()) FROM orders | MUTATION
my | query | dev | SELECT GROUP_CONCAT(DISTINCT status ORDER BY id SEPARATOR ',') FROM orders | READ
my | query | dev | SELECT id FROM orders WHERE MATCH(note) AGAINST ('x' IN BOOLEAN MODE) | READ
my | query | dev | SELECT CAST(total AS DECIMAL(10, 2)), CONVERT(note, CHAR(20)), CONVERT(note USING utf8mb4) FROM orders | READ
my | query | dev | SELECT * FROM (SELECT 1, 2) AS dt (a, b) | READ
my | query | dev | SELECT f_read() | READ | allowed=f_read
my | query | dev | SELECT 1; SELECT 2 | DENY multi-statement
my | query | dev | UPDATE orders SET status = 'x' | DENY query-writes
my | execute | dev | UPDATE orders SET status = 'x' WHERE id = 1 | MUTATION
my | execute | dev | INSERT INTO orders (id, status) VALUES (1, 'new') | MUTATION
my | execute | dev | REPLACE INTO orders (id) VALUES (1) | MUTATION
my | execute | dev | DELETE FROM orders WHERE id = 1 | MUTATION
my | execute | dev | UPDATE orders SET a = 1; UPDATE order_items SET b = 2 | DENY multi-statement
my | execute | dev | CREATE TABLE t (id int) | MUTATION
my | execute | prod | DROP TABLE orders | DENY block_ddl | ddl=deny
my | execute | prod | DROP TABLE orders | MUTATION
my | execute | stage | ALTER TABLE orders ADD COLUMN x int | DENY block_ddl | ddl=deny
my | execute | dev | SET @a = 1 | DENY forbidden
my | execute | dev | SET SESSION sql_mode = 'ANSI_QUOTES' | DENY forbidden
my | execute | dev | USE other | DENY forbidden
my | execute | dev | LOAD DATA LOCAL INFILE '/etc/passwd' INTO TABLE t | DENY forbidden
my | execute | dev | HANDLER orders OPEN | DENY forbidden
my | execute | dev | KILL 12 | DENY forbidden
my | execute | dev | LOCK TABLES orders WRITE | DENY forbidden
my | execute | dev | START TRANSACTION | DENY forbidden
# MySQL runs what /*! … */ and /*M! … */ hold: it is read as code for what is refused everywhere.
my | execute | dev | /*!50000 SET autocommit = 0 */ | DENY forbidden
my | execute | dev | /*!40101 SET @saved := @@sql_mode */ | DENY forbidden
my | execute | dev | /*M!100100 LOCK TABLES orders WRITE */ | DENY forbidden
my | execute | dev | UPDATE orders SET a = 1 /*!50000 , note = GET_LOCK('a', 1) */ | DENY function-denied
my | execute | dev | SET autocommit = 0; SELECT 'unclosed | DENY forbidden
my | execute | dev | SELECT GET_LOCK('a', 10) # x | DENY function-denied
my | execute | dev | DO RELEASE_ALL_LOCKS() | DENY function-denied
# Not analyzed, and nothing in it is refused everywhere: a person may approve it on dev.
my | execute | dev | /*!50000 UPDATE orders SET a = 1 */ | MUTATION
my | execute | dev | UPDATE orders SET a = 1 # note | MUTATION
my | execute | dev | SELECT 1 | DENY execute-read
my | query | dev | SELECT * FROM mysql.user | READ
my | query | dev | SELECT * FROM mysql.user | DENY table-not-allowed | allowlist=app.*
my | query | dev | SELECT * FROM mysql.user | DENY table-not-allowed | allowlist=*
my | query | dev | SELECT * FROM app.orders | READ | allowlist=app.orders
my | query | dev | SELECT * FROM orders | READ | allowlist=app.orders
my | query | dev | SELECT `orders`.id FROM `orders` | READ | allowlist=app.orders
my | query | dev | SELECT * FROM ORDERS | DENY table-not-allowed | allowlist=app.orders
my | query | dev | SELECT * FROM other.orders | DENY table-not-allowed | allowlist=app.orders
my | query | dev | SELECT 1 FROM DUAL | READ | allowlist=app.orders
my | query | dev | SELECT * FROM orders | DENY table-not-allowed | allowlist=app.orders;nodb
my | query | dev | SELECT * FROM app.orders | READ | allowlist=app.orders;nodb
my | execute | dev | UPDATE secrets SET a = 1 | DENY table-not-allowed | allowlist=app.orders
#
# ── GR-06: a cast of a function's name must not hide a real call of it ─────────────────────────────────────
pg | query | dev | SELECT CAST(NULL AS pg_terminate_backend) FROM orders WHERE note LIKE 'y' ESCAPE pg_terminate_backend(1)::text | DENY function-denied
pg | query | dev | SELECT NULL::pg_terminate_backend FROM orders WHERE note LIKE 'y' ESCAPE pg_terminate_backend(1)::text | DENY function-denied
pg | query | dev | SELECT CAST(NULL AS pg_read_file) FROM orders WHERE note SIMILAR TO 'x' ESCAPE pg_read_file('/etc/passwd')::text | DENY function-denied
pg | query | dev | SELECT note::varchar(10), CAST(total AS numeric(10, 2)), now()::date FROM orders | READ
#
# ── GR-06: EXPLAIN <table> (a DESCRIBE synonym) is checked against the allowlist, not passed with no tables ─
my | query | dev | EXPLAIN orders | READ
my | query | dev | EXPLAIN orders | READ | allowlist=app.orders
my | query | dev | EXPLAIN other.secret | DENY table-not-allowed | allowlist=app.orders
my | query | dev | EXPLAIN other.secret | READ
#
# ── GR-06: SHOW exposes server-wide metadata, so a restricted connection fails closed ──────────────────────
my | query | dev | SHOW DATABASES | READ
my | query | dev | SHOW DATABASES | DENY table-not-allowed | allowlist=app.orders
my | query | dev | SHOW VARIABLES | DENY table-not-allowed | allowlist=app.orders
pg | query | dev | SHOW search_path | DENY table-not-allowed | allowlist=public.orders
#
# ── GR-06: a denied function inside CALL is refused, not sent for approval ──────────────────────────────────
pg | query | dev | CALL p(pg_terminate_backend(1)) | DENY function-denied
pg | execute | dev | CALL p(pg_terminate_backend(1)) | DENY function-denied
my | query | dev | CALL p(GET_LOCK('a', 10)) | DENY function-denied
my | execute | dev | CALL p(GET_LOCK('a', 10)) | DENY function-denied
pg | execute | dev | CALL p(1) | MUTATION
#
# ── The parser reads the text the server's lexer reads, or the statement is not analyzed ─────────────────────
# Comment forms only the parser knows: a call is refused, not read as if the rest of the line were not there.
pg | query | dev | SELECT 1 // x FROM secrets | DENY unparsed | allowlist=public.orders
my | query | dev | SELECT 1 // x FROM secrets | DENY unparsed | allowlist=app.orders
# MySQL starts a "--" comment only before white space; the parser always does.
my | query | dev | SELECT 1--1 FROM secrets | DENY unparsed | allowlist=app.orders
my | query | dev | SELECT 1--1 FROM orders INTO OUTFILE '/tmp/orders.csv' | DENY unparsed
# MySQL's block comments don't nest; the parser's do.
my | query | dev | SELECT 1 /* a /* b */ , (SELECT id FROM secrets) -- */ | DENY table-not-allowed | allowlist=app.orders
my | query | dev | SELECT 1 /* a /* b */ , (SELECT id FROM secrets) -- */ | READ
# The always-forbidden file clauses are found in the text the server reads, not in what the parser took for a comment.
my | query | dev | SELECT * FROM orders /* a /* b */ INTO DUMPFILE '/tmp/orders.bin' | DENY forbidden
my | query | dev | SELECT * FROM orders INTO /* a /* b */ OUTFILE '/tmp/orders.csv' | DENY forbidden
# A MySQL double-quoted string with an escape; the parser reads an identifier that ends at the escaped quote.
my | query | dev | SELECT "\"" FROM secrets | DENY table-not-allowed | allowlist=app.orders
# A PostgreSQL E'…' string with an escaped quote; the parser ends it at the quote and reads a comment in it.
pg | query | dev | SELECT id FROM orders WHERE note = E'\' --' OR id IN (SELECT id FROM secrets) | DENY unparsed | allowlist=public.orders
# Strings the parser reads as the lexer does stay reads.
my | query | dev | SELECT "a;b", 'it''s', 'a\'b' FROM orders | READ | allowlist=app.orders
pg | query | dev | SELECT 'it''s', E'a\\b', $$x'y$$ FROM orders | READ | allowlist=public.orders
my | query | dev | SELECT 1 /* one */ FROM orders -- two | READ | allowlist=app.orders
# A name that MySQL-family servers accept and the parser's lexer reads as the start of a string that runs on.
my | query | dev | SELECT s.id FROM orders $$o, secrets s | DENY unparsed | allowlist=app.orders
my | execute | dev | SELECT s.id FROM orders $$o, secrets s | DENY unparsed | allowlist=app.orders
my | query | dev | SELECT 1 FROM orders $$o, secrets s WHERE 1 = 1 AND x = $$ | DENY unparsed | allowlist=app.orders
my | query | dev | SELECT 1 FROM orders $$o INTO OUTFILE '/tmp/orders.csv' | DENY unparsed
my | query | dev | SELECT 1 FROM orders $$o FOR UPDATE | DENY unparsed
# A name followed by a string that opens like the parser's alternative quotes, which it reads as one literal.
my | query | dev | SELECT q'{a' FROM orders, secrets WHERE '}' = '' | DENY unparsed | allowlist=app.orders
# In PostgreSQL a double dollar sign is a string or part of a name, and the parser reads it the same way.
pg | query | dev | SELECT a$$b FROM orders | READ | allowlist=public.orders
#
# ── Subqueries in operand positions the table walk used to skip are checked like any other ───────────────────
pg | query | dev | SELECT JSON_ARRAYAGG(id ORDER BY (SELECT id FROM secrets)) FROM orders | DENY table-not-allowed | allowlist=public.orders
pg | query | dev | SELECT JSON_OBJECTAGG(id : (SELECT id FROM secrets)) FROM orders | DENY table-not-allowed | allowlist=public.orders
pg | query | dev | SELECT id FROM orders WHERE note LIKE 'a%' ESCAPE (SELECT note FROM secrets LIMIT 1) | DENY table-not-allowed | allowlist=public.orders
my | query | dev | SELECT id FROM orders WHERE note LIKE 'a%' ESCAPE (SELECT note FROM secrets LIMIT 1) | DENY table-not-allowed | allowlist=app.orders
pg | query | dev | SELECT JSON_OBJECTAGG(tags[(SELECT 1 FROM secrets)] : id) FROM orders | DENY table-not-allowed | allowlist=public.orders
pg | query | dev | SELECT JSON_ARRAYAGG(id) OVER (PARTITION BY (SELECT id FROM secrets)) FROM orders | DENY table-not-allowed | allowlist=public.orders
pg | query | dev | SELECT JSON_ARRAYAGG(id) OVER (ORDER BY (SELECT id FROM secrets)) FROM orders | DENY table-not-allowed | allowlist=public.orders
pg | query | dev | SELECT tags[(SELECT 1 FROM secrets)] FROM orders | DENY table-not-allowed | allowlist=public.orders
#
# A SHOW has no table list: a subquery in its condition can't pass a restricted allowlist.
my | query | dev | SHOW TABLES WHERE Tables_in_app IN (SELECT name FROM secrets) | DENY table-not-allowed | allowlist=app.orders
