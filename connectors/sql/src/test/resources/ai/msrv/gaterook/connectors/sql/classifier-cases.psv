pg | execute | dev | DO $$ BEGIN PERFORM pg_sleep(1); END $$ | MUTATION
pg | execute | prod | DO $$ BEGIN PERFORM 1; END $$ | DENY unparsed | ddl=deny
pg | query | dev | LISTEN orders_changed | DENY forbidden
pg | query | dev | NOTIFY orders_changed | DENY forbidden
pg | query | dev | VACUUM orders | DENY forbidden
pg | query | dev | PREPARE p AS SELECT 1 | DENY forbidden
pg | query | dev | EXECUTE p | DENY forbidden
pg | query | dev | LOCK TABLE orders IN ACCESS EXCLUSIVE MODE | DENY forbidden
