# ── PostgreSQL, sql_query: what isn't a read ──────────────────────────────────────────────────────────────
pg | query | dev | SELECT * FROM orders FOR UPDATE | DENY query-writes
pg | query | dev | SELECT * FROM orders FOR SHARE | DENY query-writes
pg | query | dev | SELECT * FROM (SELECT * FROM orders FOR UPDATE) t | DENY query-writes
pg | query | dev | WITH d AS (DELETE FROM orders WHERE id = 1 RETURNING *) SELECT * FROM d | DENY query-writes
pg | query | dev | WITH u AS (UPDATE orders SET status = 'x' RETURNING id) SELECT count(*) FROM u | DENY query-writes
pg | query | dev | WITH i AS (INSERT INTO orders (id) VALUES (1) RETURNING id) SELECT * FROM i | DENY query-writes
pg | query | dev | SELECT * INTO new_orders FROM orders | DENY query-writes
pg | query | dev | UPDATE orders SET status = 'x' | DENY query-writes
pg | query | dev | DELETE FROM orders | DENY query-writes
pg | query | dev | INSERT INTO orders (id) VALUES (1) | DENY query-writes
pg | query | dev | CREATE TABLE t (id int) | DENY query-writes
pg | query | dev | DROP TABLE orders | DENY query-writes
pg | query | dev | TRUNCATE orders | DENY query-writes
pg | query | dev | CALL p_write() | DENY query-writes
pg | query | dev | EXPLAIN ANALYZE DELETE FROM orders | DENY query-writes
pg | query | dev | EXPLAIN ANALYZE UPDATE orders SET status = 'x' | DENY query-writes
# EXPLAIN ANALYZE runs the statement, so functions inside it are seen (review 2026-10-26): the parser recurses into it.
pg | query | dev | EXPLAIN ANALYZE SELECT dblink_exec('x', 'DROP TABLE orders') | DENY function-denied
pg | query | dev | EXPLAIN ANALYZE SELECT my_wrapper() | MUTATION
pg | query | prod | EXPLAIN ANALYZE SELECT my_wrapper() | DENY function-not-built-in
pg | query | dev | SELECT 1; SELECT 2 | DENY multi-statement
pg | query | dev | SELECT 1; DROP TABLE orders | DENY multi-statement
