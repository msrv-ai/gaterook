{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "database": {
      "type": "string",
      "minLength": 1,
      "maxLength": 257,
      "description": "A database other than the connection's, such as ANALYTICS; a name with lower case or spaces in double quotes."
    },
    "schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 257,
      "description": "Only this schema."
    },
    "pattern": {
      "type": "string",
      "maxLength": 255,
      "description": "Table name filter, LIKE syntax, case ignored: order%"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 500,
      "description": "Most tables to return."
    }
  }
}
