{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "bucket",
    "object"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "bucket": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,221}[a-z0-9]$",
      "description": "The bucket, such as acme-stage-uploads"
    },
    "object": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "The object's full name in the bucket, such as reports/2026-q3.csv"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "The first byte to read; continue with nextOffset"
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144,
      "default": 65536,
      "description": "Bytes to read at most, lowered to the call's size limit"
    },
    "generation": {
      "type": "string",
      "pattern": "^\\d{1,20}$",
      "description": "A specific generation of the object. Default: the live one"
    }
  }
}
