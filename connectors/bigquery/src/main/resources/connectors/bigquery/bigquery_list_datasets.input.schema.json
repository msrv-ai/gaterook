{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 100,
      "description": "Most datasets to return."
    },
    "cursor": {
      "type": "string",
      "maxLength": 8192,
      "description": "nextCursor of the previous answer; leave it out for the first page."
    }
  }
}
