<?xml version="1.0" encoding="UTF-8"?>
<!--
  Google BigQuery (docs/bigquery.md): datasets, tables, GoogleSQL SELECT as reads, one approved DML or DDL statement
  per change. BigQuery's REST API v2 over java.net.http with a token from connectors/cloud-auth (ADC, a service
  account key, impersonation). A dry run names the statement type, the tables and the bytes before anything runs.
  No Google client library. Spring only in the .boot subpackage.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>connectors-bigquery</artifactId>
  <name>GateRook · Connectors · BigQuery</name>

  <dependencies>
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>connector-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>connectors-support</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>connectors-cloud-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- GoogleCredentials of connectors/cloud-auth: tokens only, no Google API client library. -->
    <dependency>
      <groupId>com.google.auth</groupId>
      <artifactId>google-auth-library-oauth2-http</artifactId>
    </dependency>

    <!-- Registration of the built-in beans, .boot subpackage only (ARCHITECTURE.md §2.3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- No emulator: the REST API is faked with MockWebServer in every build. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
