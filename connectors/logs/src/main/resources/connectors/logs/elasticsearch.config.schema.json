{
  "title": "Elasticsearch",
  "required": [
    "backend",
    "url",
    "auth"
  ],
  "properties": {
    "backend": {
      "type": "string",
      "const": "elasticsearch",
      "default": "elasticsearch"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/?#]+$",
      "title": "Server URL",
      "examples": [
        "https://search.example.test:9200"
      ],
      "description": "Elasticsearch host, including http:// or https:// and its port."
    },
    "auth": {
      "type": "object",
      "title": "Authorization",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "title": "Authentication",
          "enum": [
            "basic",
            "apiKey",
            "bearer",
            "none"
          ],
          "default": "basic",
          "x-enumTitles": [
            "Username and password",
            "API key",
            "Bearer token",
            "No authentication"
          ]
        }
      },
      "patternProperties": {
        "^(username|secret)$": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "basic"
              }
            }
          },
          "then": {
            "required": [
              "username",
              "secret"
            ],
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": ".*\\S.*",
                "title": "Username"
              },
              "secret": {
                "type": "string",
                "minLength": 1,
                "writeOnly": true,
                "x-gateway-secret": "value",
                "format": "password",
                "title": "Password",
                "description": "Stored securely by GateRook."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "apiKey"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "secret"
            ],
            "properties": {
              "secret": {
                "type": "string",
                "minLength": 1,
                "writeOnly": true,
                "x-gateway-secret": "value",
                "format": "password",
                "title": "API key",
                "description": "Encoded Elasticsearch API key (the encoded value returned when creating a key, or Base64 of id:api_key). Do not include the ApiKey prefix."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "bearer"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "secret"
            ],
            "properties": {
              "secret": {
                "type": "string",
                "minLength": 1,
                "writeOnly": true,
                "x-gateway-secret": "value",
                "format": "password",
                "title": "Bearer token",
                "description": "Stored securely by GateRook."
              }
            }
          }
        }
      ]
    },
    "apiAccess": {
      "type": "string",
      "const": "full",
      "default": "full"
    },
    "caCertificate": {
      "type": "string",
      "maxLength": 20000,
      "x-widget": "textarea",
      "title": "CA certificate (PEM)",
      "description": "Only for a private CA."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false
}
