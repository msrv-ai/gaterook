{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Logs",
  "type": "object",
  "x-policy-section": "logs",
  "additionalProperties": false,
  "properties": {
    "maxRangeHours": {
      "type": "integer",
      "title": "Longest time range",
      "description": "Maximum log time range in hours. 0 means no time limit; a positive value denies longer ranges.",
      "minimum": 0,
      "maximum": 2562047788015,
      "default": 0,
      "x-unit": "h",
      "x-stricter": "min-positive"
    },
    "defaultLimit": {
      "type": "integer",
      "title": "Entries per call by default",
      "minimum": 1,
      "maximum": 1000,
      "default": 100,
      "x-stricter": "min",
      "x-env-default": {
        "prod": 50
      }
    },
    "maxTailWaitSeconds": {
      "type": "integer",
      "title": "Longest wait of logs_tail",
      "minimum": 0,
      "maximum": 8,
      "default": 8,
      "x-unit": "s",
      "x-stricter": "min",
      "x-env-default": {
        "prod": 3
      }
    }
  }
}
