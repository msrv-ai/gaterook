{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-legacy": true,
  "x-project-selection": {
    "path": "/resourceNames"
  },
  "required": [
    "backend"
  ],
  "properties": {
    "backend": {
      "title": "Backend",
      "enum": [
        "loki",
        "gcp-logging",
        "cloudwatch",
        "opensearch",
        "azure-monitor"
      ],
      "x-enumTitles": [
        "Loki",
        "GCP Cloud Logging",
        "AWS CloudWatch",
        "OpenSearch",
        "Azure Monitor Logs"
      ]
    }
  },
  "x-variants": [
    {
      "id": "gcp-logging",
      "name": "GCP Cloud Logging",
      "icon": "scroll-text",
      "description": "Search logs with service account impersonation.",
      "presetConfig": {
        "backend": "gcp-logging"
      },
      "tools": [
        "logs_search",
        "logs_tail"
      ]
    },
    {
      "id": "cloudwatch",
      "name": "AWS CloudWatch",
      "icon": "scroll-text",
      "description": "Logs Insights queries with AssumeRole.",
      "presetConfig": {
        "backend": "cloudwatch"
      },
      "tools": [
        "logs_search",
        "logs_tail"
      ]
    },
    {
      "id": "loki",
      "name": "Loki",
      "icon": "scroll-text",
      "description": "LogQL search and label browsing.",
      "presetConfig": {
        "backend": "loki"
      },
      "tools": [
        "logs_search",
        "logs_tail"
      ]
    },
    {
      "id": "opensearch",
      "name": "OpenSearch",
      "icon": "scroll-text",
      "description": "Scoped log search or full OpenSearch queries and approved administration.",
      "presetConfig": {
        "backend": "opensearch"
      },
      "tools": [
        "logs_search",
        "logs_tail",
        "opensearch_indices",
        "opensearch_query",
        "opensearch_request"
      ]
    }
  ],
  "oneOf": [
    {
      "title": "Loki",
      "required": [
        "backend",
        "url"
      ],
      "properties": {
        "backend": {
          "const": "loki"
        },
        "url": {
          "type": "string",
          "title": "Loki URL",
          "format": "uri",
          "pattern": "^https?://[^/?#]+(/[^?#]*)?$",
          "examples": [
            "http://loki.dev.internal:3100"
          ],
          "description": "Base URL; Grafana Cloud: https://logs-prod-XXX.grafana.net"
        },
        "tenant": {
          "type": "string",
          "maxLength": 150,
          "pattern": "^[A-Za-z0-9!._*'()|-]*$",
          "title": "Tenant (X-Scope-OrgID)",
          "description": "Empty for single-tenant Loki. Several: team-a|team-b"
        },
        "auth": {
          "type": "object",
          "title": "Credentials",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "none",
                "bearer",
                "basic"
              ],
              "default": "bearer",
              "title": "Authentication",
              "x-enumTitles": [
                "No authentication",
                "Bearer token",
                "Username and password"
              ]
            }
          },
          "patternProperties": {
            "^(username|secret)$": {}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "bearer"
                  }
                }
              },
              "then": {
                "required": [
                  "secret"
                ],
                "properties": {
                  "secret": {
                    "type": "string",
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "format": "password",
                    "title": "Bearer token",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "basic"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "username",
                  "secret"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Grafana Cloud: the numeric user ID.",
                    "title": "Username",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  },
                  "secret": {
                    "type": "string",
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "format": "password",
                    "title": "Password",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "caCertificate": {
          "type": "string",
          "maxLength": 20000,
          "x-widget": "textarea",
          "title": "CA certificate (PEM)",
          "description": "Only for a private CA."
        }
      }
    },
    {
      "title": "GCP Cloud Logging",
      "required": [
        "backend",
        "resourceNames",
        "credentials"
      ],
      "properties": {
        "backend": {
          "const": "gcp-logging"
        },
        "credentials": {
          "type": "object",
          "title": "Credentials",
          "required": [
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "title": "Authentication",
              "enum": [
                "adc",
                "serviceAccountKey"
              ],
              "default": "adc",
              "x-enumTitles": [
                "Google sign-in on this computer (gcloud auth application-default login)",
                "Service account key (JSON)"
              ]
            },
            "impersonate": {
              "type": "string",
              "title": "Service account to impersonate",
              "maxLength": 254,
              "pattern": "^[a-z0-9-]+@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$",
              "examples": [
                "gw-reader@acme-prod.iam.gserviceaccount.com"
              ]
            },
            "delegates": {
              "type": "array",
              "title": "Delegation chain",
              "maxItems": 5,
              "items": {
                "type": "string"
              },
              "description": "Service accounts that pass the impersonation along, in order, as the IAM API names them. Usually empty."
            }
          },
          "patternProperties": {
            "^serviceAccountKey$": {}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "serviceAccountKey"
                  }
                },
                "required": [
                  "source"
                ]
              },
              "then": {
                "required": [
                  "serviceAccountKey"
                ],
                "properties": {
                  "serviceAccountKey": {
                    "type": "string",
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "x-widget": "textarea",
                    "maxLength": 10000,
                    "title": "Service account key (JSON)",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "resourceNames": {
          "type": "array",
          "title": "Project or log view scope",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "examples": [
            [
              "projects/acme-prod"
            ]
          ],
          "items": {
            "type": "string",
            "title": "Resource scope",
            "examples": [
              "projects/example-prod"
            ],
            "pattern": "^(projects|folders|organizations|billingAccounts)/[A-Za-z0-9._:-]+(/locations/[a-z0-9-]+/buckets/[A-Za-z0-9_-]+/views/[A-Za-z0-9_-]+)?$"
          },
          "description": "Use projects/<project-id>, for example projects/example-prod, or a full log view resource name. A log view is the tightest scope."
        },
        "scopeFilter": {
          "type": "string",
          "maxLength": 2000,
          "title": "Always add this filter",
          "examples": [
            "resource.type=\"k8s_container\" AND resource.labels.namespace_name=\"app\""
          ]
        },
        "quotaPerMinute": {
          "type": "integer",
          "title": "API calls per minute",
          "minimum": 1,
          "maximum": 60,
          "default": 30,
          "description": "Share of the project's 60 entries.list calls per minute this gateway may use."
        }
      }
    },
    {
      "title": "AWS CloudWatch",
      "required": [
        "backend",
        "region",
        "logGroups",
        "credentials"
      ],
      "properties": {
        "backend": {
          "const": "cloudwatch"
        },
        "region": {
          "type": "string",
          "title": "Region",
          "pattern": "^[a-z]{2}(-[a-z]+)+-\\d+$",
          "examples": [
            "eu-central-1"
          ]
        },
        "logGroups": {
          "type": "array",
          "title": "Log groups",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^([.\\-_/#A-Za-z0-9]{1,512}|arn:aws[a-z-]*:logs:[a-z0-9-]+:\\d{12}:log-group:[.\\-_/#A-Za-z0-9]+)$"
          }
        },
        "credentials": {
          "$ref": "#/$defs/awsCredentials",
          "title": "Credentials"
        },
        "searchApi": {
          "title": "Search API",
          "enum": [
            "insights",
            "filter"
          ],
          "default": "insights",
          "x-enumTitles": [
            "Logs Insights (billed per GB scanned)",
            "Filter patterns (FilterLogEvents)"
          ]
        }
      }
    },
    {
      "title": "OpenSearch",
      "required": [
        "backend",
        "url",
        "auth"
      ],
      "properties": {
        "backend": {
          "const": "opensearch"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#]+$",
          "title": "Server URL",
          "examples": [
            "https://search.example.test:9200"
          ],
          "description": "OpenSearch host, including http:// or https:// and its port."
        },
        "auth": {
          "type": "object",
          "title": "Authorization",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "title": "Authentication",
              "enum": [
                "basic",
                "apiKey",
                "bearer",
                "awsSigV4",
                "none"
              ],
              "default": "basic",
              "x-enumTitles": [
                "Username and password",
                "API key",
                "Bearer token",
                "AWS request signing",
                "No authentication"
              ]
            }
          },
          "patternProperties": {
            "^(username|secret|awsRegion|awsService|awsCredentials)$": {}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "basic"
                  }
                }
              },
              "then": {
                "required": [
                  "username",
                  "secret"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": ".*\\S.*",
                    "title": "Username"
                  },
                  "secret": {
                    "type": "string",
                    "minLength": 1,
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "format": "password",
                    "title": "Password",
                    "description": "Stored securely by GateRook."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "apiKey"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "secret"
                ],
                "properties": {
                  "secret": {
                    "type": "string",
                    "minLength": 1,
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "format": "password",
                    "title": "API key",
                    "description": "OpenSearch API key, such as os_...; requires server support."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "bearer"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "secret"
                ],
                "properties": {
                  "secret": {
                    "type": "string",
                    "minLength": 1,
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "format": "password",
                    "title": "Bearer token",
                    "description": "Stored securely by GateRook."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "awsSigV4"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "awsRegion",
                  "awsCredentials"
                ],
                "properties": {
                  "awsRegion": {
                    "type": "string",
                    "title": "AWS region",
                    "pattern": "^[a-z]{2}(-[a-z]+)+-\\d+$",
                    "examples": [
                      "eu-central-1"
                    ]
                  },
                  "awsService": {
                    "title": "AWS service",
                    "enum": [
                      "es",
                      "aoss"
                    ],
                    "default": "es",
                    "x-enumTitles": [
                      "OpenSearch Service",
                      "OpenSearch Serverless"
                    ]
                  },
                  "awsCredentials": {
                    "$ref": "#/$defs/awsCredentials"
                  }
                }
              }
            }
          ]
        },
        "apiAccess": {
          "enum": [
            "logs",
            "full"
          ],
          "default": "full",
          "title": "OpenSearch API access",
          "x-enumTitles": [
            "Scoped log search",
            "Full OpenSearch REST API"
          ],
          "description": "Full API access is the default and enables arbitrary queries and server operations using this connection user's OpenSearch permissions. Log index patterns and scopeQuery restrict only logs_search and logs_tail; they do not restrict REST tools. Select Scoped log search to disable the full REST tools.",
          "x-section": "/advanced"
        },
        "timestampField": {
          "type": "string",
          "default": "@timestamp",
          "x-section": "/advanced",
          "title": "Timestamp field"
        },
        "messageField": {
          "type": "string",
          "default": "message",
          "x-section": "/advanced",
          "title": "Message field"
        },
        "severityField": {
          "type": "string",
          "default": "log.level",
          "x-section": "/advanced",
          "title": "Severity field"
        },
        "labelFields": {
          "type": "array",
          "maxItems": 20,
          "default": [
            "service.name",
            "kubernetes.namespace",
            "kubernetes.pod.name",
            "host.name"
          ],
          "items": {
            "type": "string"
          },
          "x-section": "/advanced",
          "title": "Label fields"
        },
        "scopeQuery": {
          "type": "string",
          "maxLength": 2000,
          "title": "Always add this query (Lucene)",
          "description": "Lucene filter always added to logs_search and logs_tail. Does not constrain full OpenSearch REST API tools.",
          "x-section": "/advanced"
        },
        "caCertificate": {
          "type": "string",
          "maxLength": 20000,
          "x-widget": "textarea",
          "title": "CA certificate (PEM)",
          "description": "Only for a private CA.",
          "x-section": "/advanced"
        },
        "advanced": {
          "type": "object",
          "title": "Advanced",
          "description": "Log field mappings, log scope, API access and private certificate authority.",
          "properties": {},
          "x-collapsed": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "apiAccess": {
                "const": "logs"
              }
            },
            "required": [
              "apiAccess"
            ]
          },
          "then": {
            "required": [
              "indices"
            ],
            "properties": {
              "indices": {
                "$ref": "#/$defs/openSearchLogIndices",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._*-]{0,254}$"
                }
              }
            }
          },
          "else": {
            "properties": {
              "indices": {
                "$ref": "#/$defs/openSearchLogIndices"
              }
            }
          }
        }
      ]
    },
    {
      "title": "Azure Monitor Logs",
      "required": [
        "backend",
        "credentials"
      ],
      "properties": {
        "backend": {
          "const": "azure-monitor"
        },
        "cloud": {
          "title": "Cloud",
          "enum": [
            "AzureCloud",
            "AzureUSGovernment",
            "AzureChinaCloud"
          ],
          "default": "AzureCloud",
          "x-enumTitles": [
            "Azure",
            "Azure Government",
            "Azure China (21Vianet)"
          ]
        },
        "tenantId": {
          "type": "string",
          "title": "Tenant (directory) ID",
          "maxLength": 253,
          "pattern": "^([0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}|[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+)$",
          "examples": [
            "contoso.onmicrosoft.com"
          ],
          "description": "A directory ID or domain. Required for a service principal or a device sign-in; empty uses the Azure CLI's default tenant."
        },
        "credentials": {
          "type": "object",
          "title": "Credentials",
          "required": [
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "title": "Sign in with",
              "enum": [
                "cli",
                "deviceCode",
                "clientSecret",
                "clientCertificate"
              ],
              "default": "cli",
              "x-enumTitles": [
                "Azure CLI sign-in on this computer (az login)",
                "Sign in with a code in the browser",
                "Service principal with a client secret",
                "Service principal with a certificate"
              ]
            },
            "clientId": {
              "type": "string",
              "title": "Application (client) ID",
              "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
              "description": "Required for a service principal. A device sign-in uses Azure CLI's public client unless you name your organization's app."
            }
          },
          "patternProperties": {
            "^(clientSecret|certificate)$": {}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "clientSecret"
                  }
                },
                "required": [
                  "source"
                ]
              },
              "then": {
                "required": [
                  "clientId",
                  "clientSecret"
                ],
                "properties": {
                  "clientSecret": {
                    "type": "string",
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "format": "password",
                    "title": "Client secret",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "clientCertificate"
                  }
                },
                "required": [
                  "source"
                ]
              },
              "then": {
                "required": [
                  "clientId",
                  "certificate"
                ],
                "properties": {
                  "certificate": {
                    "type": "string",
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "x-widget": "textarea",
                    "maxLength": 20000,
                    "minLength": 1,
                    "title": "Certificate and private key (PEM)",
                    "description": "An RSA private key (unencrypted PKCS#8 or PKCS#1) and its certificate, as az ad sp create-for-rbac --create-cert writes them."
                  }
                }
              }
            }
          ]
        },
        "trustedCli": {
          "type": "string",
          "title": "Allowed Azure CLI command",
          "readOnly": true,
          "x-person-only": true,
          "pattern": "^[0-9a-f]{64}$",
          "description": "Set by Test connection when you allow GateRook to run az account get-access-token with your user rights; a changed command needs your approval again."
        },
        "workspaces": {
          "type": "array",
          "title": "Log Analytics workspaces",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "title": "Workspace ID",
            "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
          },
          "examples": [
            [
              "5b2f8c1e-0a3d-4e6f-9b7a-1c2d3e4f5a6b"
            ]
          ],
          "description": "Workspace IDs (GUIDs, on the workspace's Overview) agents may query."
        },
        "applicationInsights": {
          "type": "array",
          "title": "Application Insights components",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "title": "Component resource ID",
            "maxLength": 512,
            "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/[Mm]icrosoft\\.[Ii]nsights/components/[^/]+$"
          },
          "examples": [
            [
              "/subscriptions/0b1f6471-1bf0-4dda-aec3-111122223333/resourceGroups/stage-app/providers/Microsoft.Insights/components/stage-api"
            ]
          ],
          "description": "Components whose requests, exceptions, dependencies and traces the log tools read."
        }
      }
    }
  ],
  "$defs": {
    "openSearchLogIndices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(\\*|[a-z0-9][a-z0-9._*-]{0,254})$"
      },
      "examples": [
        [
          "logs-app-*"
        ]
      ],
      "description": "Index patterns for logs_search, logs_tail and log-only index discovery. Required in scoped log mode. Full API mode defaults to * when omitted; REST tools use the server user's permissions instead.",
      "title": "Log index patterns",
      "x-section": "/advanced"
    },
    "awsCredentials": {
      "type": "object",
      "title": "AWS credentials",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "accessKey",
            "profile"
          ],
          "default": "accessKey",
          "title": "Credential source",
          "x-enumTitles": [
            "Access key",
            "AWS profile"
          ]
        },
        "roleArn": {
          "type": "string",
          "pattern": "^arn:aws[a-z-]*:iam::\\d{12}:role/[\\w+=,.@/-]+$",
          "examples": [
            "arn:aws:iam::123456789012:role/gw-readonly"
          ],
          "title": "Assume role ARN"
        },
        "externalId": {
          "type": "string",
          "maxLength": 1224,
          "title": "External ID"
        },
        "sessionSeconds": {
          "type": "integer",
          "minimum": 900,
          "maximum": 3600,
          "default": 900,
          "x-unit": "s",
          "title": "Session duration"
        }
      },
      "patternProperties": {
        "^(accessKeyId|secretAccessKey|profile)$": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "accessKey"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "accessKeyId",
              "secretAccessKey"
            ],
            "properties": {
              "accessKeyId": {
                "type": "string",
                "pattern": "^(AKIA|ASIA)[A-Z0-9]{16}$",
                "x-not-secret": true,
                "title": "Access key ID"
              },
              "secretAccessKey": {
                "type": "string",
                "writeOnly": true,
                "x-gateway-secret": "value",
                "format": "password",
                "title": "Secret access key",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
