{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "backend"
  ],
  "properties": {
    "backend": {
      "title": "Backend",
      "enum": [
        "loki",
        "gcp-logging",
        "cloudwatch",
        "opensearch"
      ],
      "x-enumTitles": [
        "Loki",
        "GCP Cloud Logging",
        "AWS CloudWatch",
        "OpenSearch"
      ]
    }
  },
  "x-variants": [
    {
      "id": "gcp-logging",
      "name": "GCP Cloud Logging",
      "icon": "scroll-text",
      "description": "Search logs with service account impersonation.",
      "presetConfig": {
        "backend": "gcp-logging"
      },
      "tools": [
        "logs_search",
        "logs_tail"
      ]
    },
    {
      "id": "cloudwatch",
      "name": "AWS CloudWatch",
      "icon": "scroll-text",
      "description": "Logs Insights queries with AssumeRole.",
      "presetConfig": {
        "backend": "cloudwatch"
      },
      "tools": [
        "logs_search",
        "logs_tail"
      ]
    },
    {
      "id": "loki",
      "name": "Loki",
      "icon": "scroll-text",
      "description": "LogQL search and label browsing.",
      "presetConfig": {
        "backend": "loki"
      },
      "tools": [
        "logs_search",
        "logs_tail"
      ]
    },
    {
      "id": "opensearch",
      "name": "OpenSearch",
      "icon": "scroll-text",
      "description": "Scoped log search or full OpenSearch queries and approved administration.",
      "presetConfig": {
        "backend": "opensearch"
      },
      "tools": [
        "logs_search",
        "logs_tail",
        "opensearch_indices",
        "opensearch_query",
        "opensearch_request"
      ]
    }
  ],
  "oneOf": [
    {
      "title": "Loki",
      "required": [
        "backend",
        "url"
      ],
      "properties": {
        "backend": {
          "const": "loki"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#]+(/[^?#]*)?$",
          "examples": [
            "http://loki.dev.internal:3100"
          ],
          "description": "Base URL; Grafana Cloud: https://logs-prod-XXX.grafana.net"
        },
        "tenant": {
          "type": "string",
          "maxLength": 150,
          "pattern": "^[A-Za-z0-9!._*'()|-]*$",
          "title": "Tenant (X-Scope-OrgID)",
          "description": "Empty for single-tenant Loki. Several: team-a|team-b"
        },
        "auth": {
          "type": "object",
          "title": "Credentials",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "none",
                "bearer",
                "basic"
              ],
              "default": "bearer"
            },
            "username": {
              "type": "string",
              "maxLength": 200,
              "description": "basic only. Grafana Cloud: the numeric user ID"
            },
            "secret": {
              "type": "string",
              "writeOnly": true,
              "x-gateway-secret": "value",
              "format": "password",
              "title": "Token or password"
            }
          }
        },
        "caCertificate": {
          "type": "string",
          "maxLength": 20000,
          "x-widget": "textarea",
          "title": "CA certificate (PEM)",
          "description": "Only for a private CA."
        }
      }
    },
    {
      "title": "GCP Cloud Logging",
      "required": [
        "backend",
        "resourceNames",
        "credentials"
      ],
      "properties": {
        "backend": {
          "const": "gcp-logging"
        },
        "resourceNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "examples": [
            [
              "projects/acme-prod"
            ]
          ],
          "items": {
            "type": "string",
            "pattern": "^(projects|folders|organizations|billingAccounts)/[A-Za-z0-9._:-]+(/locations/[a-z0-9-]+/buckets/[A-Za-z0-9_-]+/views/[A-Za-z0-9_-]+)?$"
          },
          "description": "Projects or log views. A log view is the tightest scope."
        },
        "credentials": {
          "type": "object",
          "title": "Credentials",
          "required": [
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "adc",
                "serviceAccountKey"
              ],
              "default": "adc",
              "x-enumTitles": [
                "Google sign-in on this computer (gcloud auth application-default login)",
                "Service account key (JSON)"
              ]
            },
            "serviceAccountKey": {
              "type": "string",
              "writeOnly": true,
              "x-gateway-secret": "value",
              "x-widget": "textarea",
              "maxLength": 10000
            },
            "impersonate": {
              "type": "string",
              "maxLength": 254,
              "pattern": "^[a-z0-9-]+@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$",
              "examples": [
                "gw-reader@acme-prod.iam.gserviceaccount.com"
              ]
            },
            "delegates": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "scopeFilter": {
          "type": "string",
          "maxLength": 2000,
          "title": "Always add this filter",
          "examples": [
            "resource.type=\"k8s_container\" AND resource.labels.namespace_name=\"app\""
          ]
        },
        "quotaPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 30,
          "description": "Share of the project's 60 entries.list calls per minute this gateway may use."
        }
      }
    },
    {
      "title": "AWS CloudWatch",
      "required": [
        "backend",
        "region",
        "logGroups",
        "credentials"
      ],
      "properties": {
        "backend": {
          "const": "cloudwatch"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[a-z]+)+-\\d+$",
          "examples": [
            "eu-central-1"
          ]
        },
        "logGroups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^([.\\-_/#A-Za-z0-9]{1,512}|arn:aws[a-z-]*:logs:[a-z0-9-]+:\\d{12}:log-group:[.\\-_/#A-Za-z0-9]+)$"
          }
        },
        "credentials": {
          "type": "object",
          "title": "Credentials",
          "required": [
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "accessKey",
                "profile"
              ],
              "default": "accessKey"
            },
            "accessKeyId": {
              "type": "string",
              "pattern": "^(AKIA|ASIA)[A-Z0-9]{16}$",
              "x-not-secret": true
            },
            "secretAccessKey": {
              "type": "string",
              "writeOnly": true,
              "x-gateway-secret": "value",
              "format": "password"
            },
            "profile": {
              "type": "string",
              "maxLength": 128,
              "description": "A profile in ~/.aws/config on this computer"
            },
            "roleArn": {
              "type": "string",
              "pattern": "^arn:aws[a-z-]*:iam::\\d{12}:role/[\\w+=,.@/-]+$",
              "examples": [
                "arn:aws:iam::123456789012:role/gw-readonly"
              ]
            },
            "externalId": {
              "type": "string",
              "maxLength": 1224
            },
            "sessionSeconds": {
              "type": "integer",
              "minimum": 900,
              "maximum": 3600,
              "default": 900,
              "x-unit": "s"
            }
          }
        },
        "searchApi": {
          "enum": [
            "insights",
            "filter"
          ],
          "default": "insights",
          "x-enumTitles": [
            "Logs Insights (billed per GB scanned)",
            "Filter patterns (FilterLogEvents)"
          ]
        }
      }
    },
    {
      "title": "OpenSearch",
      "required": [
        "backend",
        "url"
      ],
      "properties": {
        "backend": {
          "const": "opensearch"
        },
        "apiAccess": {
          "enum": [
            "logs",
            "full"
          ],
          "default": "full",
          "title": "OpenSearch API access",
          "x-enumTitles": [
            "Scoped log search",
            "Full OpenSearch REST API"
          ],
          "description": "Full API access is the default and enables arbitrary queries and server operations using this connection user's OpenSearch permissions. Log index patterns and scopeQuery restrict only logs_search and logs_tail; they do not restrict REST tools. Select Scoped log search to disable the full REST tools."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#]+$"
        },
        "timestampField": {
          "type": "string",
          "default": "@timestamp"
        },
        "messageField": {
          "type": "string",
          "default": "message"
        },
        "severityField": {
          "type": "string",
          "default": "log.level"
        },
        "labelFields": {
          "type": "array",
          "maxItems": 20,
          "default": [
            "service.name",
            "kubernetes.namespace",
            "kubernetes.pod.name",
            "host.name"
          ],
          "items": {
            "type": "string"
          }
        },
        "scopeQuery": {
          "type": "string",
          "maxLength": 2000,
          "title": "Always add this query (Lucene)",
          "description": "Lucene filter always added to logs_search and logs_tail. Does not constrain full OpenSearch REST API tools."
        },
        "auth": {
          "type": "object",
          "title": "Credentials",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "none",
                "basic",
                "apiKey",
                "bearer",
                "awsSigV4"
              ],
              "default": "basic"
            },
            "username": {
              "type": "string"
            },
            "secret": {
              "type": "string",
              "writeOnly": true,
              "x-gateway-secret": "value",
              "format": "password",
              "description": "Password, ApiKey (os_\u2026, OpenSearch \u2265 3.7) or bearer token"
            },
            "awsRegion": {
              "type": "string"
            },
            "awsService": {
              "enum": [
                "es",
                "aoss"
              ],
              "default": "es"
            },
            "awsCredentials": {
              "$ref": "#/oneOf/2/properties/credentials"
            }
          }
        },
        "caCertificate": {
          "type": "string",
          "maxLength": 20000,
          "x-widget": "textarea",
          "title": "CA certificate (PEM)",
          "description": "Only for a private CA."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "apiAccess": {
                "const": "logs"
              }
            },
            "required": [
              "apiAccess"
            ]
          },
          "then": {
            "required": [
              "indices"
            ],
            "properties": {
              "indices": {
                "$ref": "#/$defs/openSearchLogIndices",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._*-]{0,254}$"
                }
              }
            }
          },
          "else": {
            "properties": {
              "indices": {
                "$ref": "#/$defs/openSearchLogIndices"
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "openSearchLogIndices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(\\*|[a-z0-9][a-z0-9._*-]{0,254})$"
      },
      "examples": [
        [
          "logs-app-*"
        ]
      ],
      "description": "Index patterns for logs_search, logs_tail and log-only index discovery. Required in scoped log mode. Full API mode defaults to * when omitted; REST tools use the server user's permissions instead.",
      "title": "Log index patterns"
    }
  }
}
