{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "backend"
  ],
  "properties": {
    "backend": {
      "title": "Backend",
      "enum": [
        "loki",
        "gcp-logging",
        "cloudwatch",
        "opensearch"
      ],
      "x-enumTitles": [
        "Loki",
        "GCP Cloud Logging",
        "AWS CloudWatch",
        "OpenSearch"
      ]
    }
  },
  "x-variants": [
    {
      "id": "gcp-logging",
      "name": "GCP Cloud Logging",
      "icon": "scroll-text",
      "description": "Search logs with service account impersonation.",
      "presetConfig": {
        "backend": "gcp-logging"
      },
      "tools": [
        "logs_search",
        "logs_tail"
      ]
    },
    {
      "id": "cloudwatch",
      "name": "AWS CloudWatch",
      "icon": "scroll-text",
      "description": "Logs Insights queries with AssumeRole.",
      "presetConfig": {
        "backend": "cloudwatch"
      },
      "tools": [
        "logs_search",
        "logs_tail"
      ]
    },
    {
      "id": "loki",
      "name": "Loki",
      "icon": "scroll-text",
      "description": "LogQL search and label browsing.",
      "presetConfig": {
        "backend": "loki"
      },
      "tools": [
        "logs_search",
        "logs_tail"
      ]
    },
    {
      "id": "opensearch",
      "name": "OpenSearch",
      "icon": "scroll-text",
      "description": "Scoped log search or full OpenSearch queries and approved administration.",
      "presetConfig": {
        "backend": "opensearch"
      },
      "tools": [
        "logs_search",
        "logs_tail",
        "opensearch_indices",
        "opensearch_query",
        "opensearch_request"
      ]
    }
  ],
  "oneOf": [
    {
      "title": "Loki",
      "required": [
        "backend",
        "url"
      ],
      "properties": {
        "backend": {
          "const": "loki"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#]+(/[^?#]*)?$",
          "examples": [
            "http://loki.dev.internal:3100"
          ],
          "description": "Base URL; Grafana Cloud: https://logs-prod-XXX.grafana.net"
        },
        "tenant": {
          "type": "string",
          "maxLength": 150,
          "pattern": "^[A-Za-z0-9!._*'()|-]*$",
          "title": "Tenant (X-Scope-OrgID)",
          "description": "Empty for single-tenant Loki. Several: team-a|team-b"
        },
        "auth": {
          "type": "object",
          "title": "Credentials",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "none",
                "bearer",
                "basic"
              ],
              "default": "bearer",
              "title": "Authentication",
              "x-enumTitles": [
                "No authentication",
                "Bearer token",
                "Username and password"
              ]
            }
          },
          "patternProperties": {
            "^(username|secret)$": {}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "bearer"
                  }
                }
              },
              "then": {
                "required": [
                  "secret"
                ],
                "properties": {
                  "secret": {
                    "type": "string",
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "format": "password",
                    "title": "Bearer token",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "basic"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "username",
                  "secret"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Grafana Cloud: the numeric user ID.",
                    "title": "Username",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  },
                  "secret": {
                    "type": "string",
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "format": "password",
                    "title": "Password",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "caCertificate": {
          "type": "string",
          "maxLength": 20000,
          "x-widget": "textarea",
          "title": "CA certificate (PEM)",
          "description": "Only for a private CA."
        }
      }
    },
    {
      "title": "GCP Cloud Logging",
      "required": [
        "backend",
        "resourceNames",
        "credentials"
      ],
      "properties": {
        "backend": {
          "const": "gcp-logging"
        },
        "resourceNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "examples": [
            [
              "projects/acme-prod"
            ]
          ],
          "items": {
            "type": "string",
            "pattern": "^(projects|folders|organizations|billingAccounts)/[A-Za-z0-9._:-]+(/locations/[a-z0-9-]+/buckets/[A-Za-z0-9_-]+/views/[A-Za-z0-9_-]+)?$"
          },
          "description": "Projects or log views. A log view is the tightest scope."
        },
        "credentials": {
          "type": "object",
          "title": "Credentials",
          "required": [
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "adc",
                "serviceAccountKey"
              ],
              "default": "adc",
              "x-enumTitles": [
                "Google sign-in on this computer (gcloud auth application-default login)",
                "Service account key (JSON)"
              ]
            },
            "impersonate": {
              "type": "string",
              "maxLength": 254,
              "pattern": "^[a-z0-9-]+@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$",
              "examples": [
                "gw-reader@acme-prod.iam.gserviceaccount.com"
              ]
            },
            "delegates": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string"
              }
            }
          },
          "patternProperties": {
            "^serviceAccountKey$": {}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "serviceAccountKey"
                  }
                },
                "required": [
                  "source"
                ]
              },
              "then": {
                "required": [
                  "serviceAccountKey"
                ],
                "properties": {
                  "serviceAccountKey": {
                    "type": "string",
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "x-widget": "textarea",
                    "maxLength": 10000,
                    "title": "Service account key (JSON)",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "scopeFilter": {
          "type": "string",
          "maxLength": 2000,
          "title": "Always add this filter",
          "examples": [
            "resource.type=\"k8s_container\" AND resource.labels.namespace_name=\"app\""
          ]
        },
        "quotaPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 30,
          "description": "Share of the project's 60 entries.list calls per minute this gateway may use."
        }
      }
    },
    {
      "title": "AWS CloudWatch",
      "required": [
        "backend",
        "region",
        "logGroups",
        "credentials"
      ],
      "properties": {
        "backend": {
          "const": "cloudwatch"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[a-z]+)+-\\d+$",
          "examples": [
            "eu-central-1"
          ]
        },
        "logGroups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^([.\\-_/#A-Za-z0-9]{1,512}|arn:aws[a-z-]*:logs:[a-z0-9-]+:\\d{12}:log-group:[.\\-_/#A-Za-z0-9]+)$"
          }
        },
        "credentials": {
          "$ref": "#/$defs/awsCredentials",
          "title": "Credentials"
        },
        "searchApi": {
          "enum": [
            "insights",
            "filter"
          ],
          "default": "insights",
          "x-enumTitles": [
            "Logs Insights (billed per GB scanned)",
            "Filter patterns (FilterLogEvents)"
          ]
        }
      }
    },
    {
      "title": "OpenSearch",
      "required": [
        "backend",
        "url",
        "auth"
      ],
      "properties": {
        "backend": {
          "const": "opensearch"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#]+$",
          "title": "Server URL",
          "examples": [
            "https://search.example.test:9200"
          ],
          "description": "OpenSearch host, including http:// or https:// and its port."
        },
        "auth": {
          "type": "object",
          "title": "Authorization",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "title": "Authentication",
              "enum": [
                "basic",
                "apiKey",
                "bearer",
                "awsSigV4",
                "none"
              ],
              "default": "basic",
              "x-enumTitles": [
                "Username and password",
                "API key",
                "Bearer token",
                "AWS request signing",
                "No authentication"
              ]
            }
          },
          "patternProperties": {
            "^(username|secret|awsRegion|awsService|awsCredentials)$": {}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "basic"
                  }
                }
              },
              "then": {
                "required": [
                  "username",
                  "secret"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": ".*\\S.*",
                    "title": "Username"
                  },
                  "secret": {
                    "type": "string",
                    "minLength": 1,
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "format": "password",
                    "title": "Password",
                    "description": "Stored securely by GateRook."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "apiKey"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "secret"
                ],
                "properties": {
                  "secret": {
                    "type": "string",
                    "minLength": 1,
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "format": "password",
                    "title": "API key",
                    "description": "OpenSearch API key, such as os_...; requires server support."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "bearer"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "secret"
                ],
                "properties": {
                  "secret": {
                    "type": "string",
                    "minLength": 1,
                    "writeOnly": true,
                    "x-gateway-secret": "value",
                    "format": "password",
                    "title": "Bearer token",
                    "description": "Stored securely by GateRook."
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "awsSigV4"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "awsRegion",
                  "awsCredentials"
                ],
                "properties": {
                  "awsRegion": {
                    "type": "string",
                    "title": "AWS region",
                    "pattern": "^[a-z]{2}(-[a-z]+)+-\\d+$",
                    "examples": [
                      "eu-central-1"
                    ]
                  },
                  "awsService": {
                    "title": "AWS service",
                    "enum": [
                      "es",
                      "aoss"
                    ],
                    "default": "es",
                    "x-enumTitles": [
                      "OpenSearch Service",
                      "OpenSearch Serverless"
                    ]
                  },
                  "awsCredentials": {
                    "$ref": "#/$defs/awsCredentials"
                  }
                }
              }
            }
          ]
        },
        "apiAccess": {
          "enum": [
            "logs",
            "full"
          ],
          "default": "full",
          "title": "OpenSearch API access",
          "x-enumTitles": [
            "Scoped log search",
            "Full OpenSearch REST API"
          ],
          "description": "Full API access is the default and enables arbitrary queries and server operations using this connection user's OpenSearch permissions. Log index patterns and scopeQuery restrict only logs_search and logs_tail; they do not restrict REST tools. Select Scoped log search to disable the full REST tools.",
          "x-section": "/advanced"
        },
        "timestampField": {
          "type": "string",
          "default": "@timestamp",
          "x-section": "/advanced",
          "title": "Timestamp field"
        },
        "messageField": {
          "type": "string",
          "default": "message",
          "x-section": "/advanced",
          "title": "Message field"
        },
        "severityField": {
          "type": "string",
          "default": "log.level",
          "x-section": "/advanced",
          "title": "Severity field"
        },
        "labelFields": {
          "type": "array",
          "maxItems": 20,
          "default": [
            "service.name",
            "kubernetes.namespace",
            "kubernetes.pod.name",
            "host.name"
          ],
          "items": {
            "type": "string"
          },
          "x-section": "/advanced",
          "title": "Label fields"
        },
        "scopeQuery": {
          "type": "string",
          "maxLength": 2000,
          "title": "Always add this query (Lucene)",
          "description": "Lucene filter always added to logs_search and logs_tail. Does not constrain full OpenSearch REST API tools.",
          "x-section": "/advanced"
        },
        "caCertificate": {
          "type": "string",
          "maxLength": 20000,
          "x-widget": "textarea",
          "title": "CA certificate (PEM)",
          "description": "Only for a private CA.",
          "x-section": "/advanced"
        },
        "advanced": {
          "type": "object",
          "title": "Advanced",
          "description": "Log field mappings, log scope, API access and private certificate authority.",
          "properties": {},
          "x-collapsed": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "apiAccess": {
                "const": "logs"
              }
            },
            "required": [
              "apiAccess"
            ]
          },
          "then": {
            "required": [
              "indices"
            ],
            "properties": {
              "indices": {
                "$ref": "#/$defs/openSearchLogIndices",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._*-]{0,254}$"
                }
              }
            }
          },
          "else": {
            "properties": {
              "indices": {
                "$ref": "#/$defs/openSearchLogIndices"
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "openSearchLogIndices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(\\*|[a-z0-9][a-z0-9._*-]{0,254})$"
      },
      "examples": [
        [
          "logs-app-*"
        ]
      ],
      "description": "Index patterns for logs_search, logs_tail and log-only index discovery. Required in scoped log mode. Full API mode defaults to * when omitted; REST tools use the server user's permissions instead.",
      "title": "Log index patterns",
      "x-section": "/advanced"
    },
    "awsCredentials": {
      "type": "object",
      "title": "AWS credentials",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "accessKey",
            "profile"
          ],
          "default": "accessKey",
          "title": "Credential source",
          "x-enumTitles": [
            "Access key",
            "AWS profile"
          ]
        },
        "roleArn": {
          "type": "string",
          "pattern": "^arn:aws[a-z-]*:iam::\\d{12}:role/[\\w+=,.@/-]+$",
          "examples": [
            "arn:aws:iam::123456789012:role/gw-readonly"
          ],
          "title": "Assume role ARN"
        },
        "externalId": {
          "type": "string",
          "maxLength": 1224,
          "title": "External ID"
        },
        "sessionSeconds": {
          "type": "integer",
          "minimum": 900,
          "maximum": 3600,
          "default": 900,
          "x-unit": "s",
          "title": "Session duration"
        }
      },
      "patternProperties": {
        "^(accessKeyId|secretAccessKey|profile)$": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "accessKey"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "accessKeyId",
              "secretAccessKey"
            ],
            "properties": {
              "accessKeyId": {
                "type": "string",
                "pattern": "^(AKIA|ASIA)[A-Z0-9]{16}$",
                "x-not-secret": true,
                "title": "Access key ID"
              },
              "secretAccessKey": {
                "type": "string",
                "writeOnly": true,
                "x-gateway-secret": "value",
                "format": "password",
                "title": "Secret access key",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "profile"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "profile"
            ],
            "properties": {
              "profile": {
                "type": "string",
                "maxLength": 128,
                "description": "A profile in ~/.aws/config on this computer",
                "title": "Profile",
                "minLength": 1,
                "pattern": ".*\\S.*"
              }
            }
          }
        }
      ]
    }
  }
}
