<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs (report 07): logs_search and logs_tail over Loki, GCP Cloud Logging, AWS CloudWatch Logs and OpenSearch,
  with HMAC-signed tail cursors. java.net.http for log reads, Apache HttpClient for unrestricted OpenSearch REST,
  google-auth for GCP tokens, the AWS SDK for CloudWatch and SigV4. Credentials come from connectors/cloud-auth.
  Spring only in the .boot subpackage. Built by step C5.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.msrv.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>connectors-logs</artifactId>
  <name>GateRook · Connectors · Logs</name>

  <dependencies>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connector-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connectors-support</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!--
      Full OpenSearch REST needs GET bodies and strictly disabled retries. The JDK client can replay GET after EOF;
      OkHttp refuses GET bodies. HttpClient 5 provides both controls without changing JVM-wide properties.
    -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connectors-cloud-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.auth</groupId>
      <artifactId>google-auth-library-oauth2-http</artifactId>
    </dependency>
    <!-- Every AWS client uses url-connection-client; Apache and Netty clients are excluded in the root pom. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>cloudwatchlogs</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sts</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>
    <!-- AwsV4HttpSigner for Amazon OpenSearch (es) and Serverless (aoss). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>http-auth-aws</artifactId>
    </dependency>

    <!-- Registration of the built-in beans, .boot subpackage only (ARCHITECTURE.md §2.3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Every answer is checked against the tools' published outputSchema (report 07 §8). -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        *IT run against real backends with -Plogs-it (tag logs-it): Loki 3.7.9 and OpenSearch 3.9.0 (min) downloaded
        into ~/.cache/mcp-gateway-test with their SHA-256 checked, moto 5.2.4 from the cached venv (CloudWatch Logs).
        Fake backends (MockWebServer) run in the default build.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
