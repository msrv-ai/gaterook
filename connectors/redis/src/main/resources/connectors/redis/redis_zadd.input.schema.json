{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "key",
    "members"
  ],
  "description": "Writes one key. Up to 1,000 elements and 1 MiB total; connection value-size and call limits also apply. Oversized writes are rejected in full.",
  "properties": {
    "connection": {
      "type": "string"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "encoding": {
      "type": "string",
      "enum": [
        "utf8",
        "base64"
      ],
      "default": "utf8",
      "description": "base64: key is the base64 of a key that isn't UTF-8, as redis_scan lists it."
    },
    "database": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1023,
      "description": "Required when several databases are selected. Defaults to the sole selected database."
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "score",
          "value"
        ],
        "properties": {
          "score": {
            "type": "number"
          },
          "value": {
            "type": "string",
            "maxLength": 2097152
          }
        }
      }
    }
  }
}
