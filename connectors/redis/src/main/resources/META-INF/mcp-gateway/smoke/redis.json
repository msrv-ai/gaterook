{
  "area": "redis",
  "module": "connectors/redis",
  "connectorTypes": ["redis"],
  "description": "Touches of the Redis connector for the native smoke (report 15 §6): Jedis' Connection and its pom.properties resource (CLIENT SETINFO), the connector's own socket factory with JSSE, the sealed cursor. The first two need no server; the third needs a redis-server (fixture redis: the local redis-server 7.0.15 started as LocalRedis does it — ACL user ro with password ro-pass, TLS on a second port with a certificate for localhost signed by a private CA, the list smoke:list holding a, b, c). A placeholder that is a whole JSON string takes the fixture value's JSON type: \"${fixture.tlsPort}\" is a number.",
  "touches": [
    {
      "name": "denied-key-without-io",
      "connection": {"type": "redis", "env": "dev",
        "config": {"connection": {"host": "127.0.0.1", "port": 1},
                   "credentials": {"user": "gw_reader"},
                   "advanced": {"keyDenylist": ["session:*"]}},
        "secrets": {"/credentials/password": "smoke-only-0001"}},
      "call": {"tool": "redis_get", "arguments": {"key": "session:42"}},
      "expect": {"isError": true, "textStartsWith": "Denied by policy dev.redis.key-not-allowed"}
    },
    {
      "name": "refused-port",
      "connection": {"type": "redis", "env": "dev",
        "config": {"connection": {"host": "127.0.0.1", "port": 1}, "credentials": {"user": "gw_reader"}},
        "secrets": {"/credentials/password": "smoke-only-0001"}},
      "test": true,
      "expect": {"ok": false, "errorCode": "redis.refused"}
    },
    {
      "name": "read-a-list-over-tls-with-cursor",
      "fixture": "redis",
      "connection": {"type": "redis", "env": "dev",
        "config": {"connection": {"host": "localhost", "port": "${fixture.tlsPort}", "tls": true, "tlsVerify": "full",
                                  "caCertificate": "${fixture.caCertificate}"},
                   "credentials": {"user": "${fixture.user}"}},
        "secrets": {"/credentials/password": "${fixture.password}"}},
      "call": {"tool": "redis_get", "arguments": {"key": "smoke:list", "limit": 1}},
      "expect": {"isError": false, "structuredContent": {"exists": true, "type": "list", "length": 3, "value": ["a"]}}
    }
  ]
}
