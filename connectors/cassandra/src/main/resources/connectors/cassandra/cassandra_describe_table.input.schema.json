{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "table"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "table": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "keyspace.table, or table in the connection's keyspace; a materialized view too. Quote names with capitals: \"Shop\".\"Orders\"."
    }
  }
}
