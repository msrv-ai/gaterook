{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "table"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "table": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800,
      "description": "catalog.schema.table, schema.table in the default catalog, or a table of the default schema."
    }
  }
}
