{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "runbook"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "runbook": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,47}$",
      "description": "A runbook of the connection; the gateway lists them per endpoint with their parameters."
    },
    "params": {
      "type": "object",
      "description": "Runbook parameters by name.",
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean"
        ]
      }
    },
    "note": {
      "type": "string",
      "maxLength": 500,
      "description": "Why you run it. Shown to the approver as unverified."
    }
  }
}
