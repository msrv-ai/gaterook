<?xml version="1.0" encoding="UTF-8"?>
<!--
  CloudCredentials (ARCHITECTURE.md §2.1, reports 07, 09, 12): gcp(spec, scopes) -> GoogleCredentials (ADC, service
  account key, impersonation for 900 s) and aws(spec, sessionPolicy) -> AwsCredentialsProvider (access key, profile,
  AssumeRole + ExternalId). Shared by the Logs, GCP and AWS connectors and by the core's GCP/AWS secret stores.
  Implemented by step M1.3. No Spring.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.msrv.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>connectors-cloud-auth</artifactId>
  <name>GateRook · Connectors · Cloud credentials</name>

  <dependencies>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connector-api</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Token only: User/ServiceAccount/ImpersonatedCredentials; the default NetHttpTransport. -->
    <dependency>
      <groupId>com.google.auth</groupId>
      <artifactId>google-auth-library-oauth2-http</artifactId>
    </dependency>
    <!-- StsAssumeRoleCredentialsProvider (ExternalId, 900 s, refresh) and GetCallerIdentity. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sts</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Impersonation and token endpoints are faked with MockWebServer (report 09 §8); STS runs against moto. -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
