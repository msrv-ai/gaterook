{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "sql"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "sql": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "description": "One SELECT, WITH, SHOW or EXPLAIN. It runs in a READ ONLY transaction that is rolled back; the endpoint caps rows."
    },
    "parameters": {
      "type": "array",
      "maxItems": 50,
      "description": "Values of the statement's :name parameters. The Data API passes each as text and Redshift casts it; write NULL in the SQL itself.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[0-9A-Za-z_]{1,128}$"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 100,
      "description": "Most rows to return; the endpoint caps it."
    },
    "cursor": {
      "type": "string",
      "maxLength": 8192,
      "description": "nextCursor of the previous answer; leave it out for the first page."
    }
  }
}
