<?xml version="1.0" encoding="UTF-8"?>
<!--
  Neo4j (docs/neo4j.md): schema and one Cypher read per call in a READ transaction that the server's EXPLAIN calls
  read only, one approved Cypher write per change in an explicit WRITE transaction, never retried. The official Neo4j
  Java driver over Bolt (neo4j://, neo4j+s://, bolt://, bolt+s://). Spring only in the .boot subpackage.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>connectors-neo4j</artifactId>
  <name>GateRook · Connectors · Neo4j</name>

  <dependencies>
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>connector-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>connectors-support</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- neo4j-java-driver.version is pinned in the root pom (Boot 4.1.2 manages 6.1.0). Netty and Reactor come with it. -->
    <dependency>
      <groupId>org.neo4j.driver</groupId>
      <artifactId>neo4j-java-driver</artifactId>
    </dependency>

    <!-- Registration of the built-in beans, .boot subpackage only (ARCHITECTURE.md §2.3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        *IT with -Pservices,neo4j-it (tag neo4j-it): the neo4j Compose service (scripts/test-services.sh up neo4j). Unit
        tests stand in for the server with a fake of the Bolt seam in every build.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
