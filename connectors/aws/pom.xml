<?xml version="1.0" encoding="UTF-8"?>
<!--
  AWS (report 09): aws_describe (Cloud Control List/Get) and aws_metrics (CloudWatch GetMetricData, ListMetrics,
  DescribeAlarms over RPCv2 CBOR) with an ExecutionInterceptor allowlist and a generated session policy.
  Credentials (AssumeRole + ExternalId) come from connectors/cloud-auth. Spring only in the .boot subpackage.
  Built by step C8.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.msrv.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>0.4.1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>connectors-aws</artifactId>
  <name>GateRook · Connectors · AWS</name>

  <dependencies>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connector-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connectors-support</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connectors-cloud-auth</artifactId>
    </dependency>
    <!-- Every AWS client uses url-connection-client; Apache and Netty clients are excluded in the root pom. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>cloudcontrol</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>cloudwatch</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sts</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>

    <!-- Registration of the built-in beans, .boot subpackage only (ARCHITECTURE.md §2.3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Cloud Control (JSON 1.0) and CloudWatch (RPCv2 CBOR) are faked on MockWebServer (report 09 §8). -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The fake CloudWatch writes and reads CBOR (timestamps as tag 1) with Jackson 3, not the SDK's shaded copy. -->
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-cbor</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Every answer is checked against the tools' published outputSchema (report 09 §8). -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        *IT with -Pcloud-it (tag cloud-it): STS through moto 5.2.4 from the cached venv
        ~/.cache/mcp-gateway-test/moto-5.2.4 (GW_MOTO_SERVER), as in connectors/cloud-auth. Cloud Control and
        CloudWatch have no moto: they are MockWebServer fakes in every build.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
