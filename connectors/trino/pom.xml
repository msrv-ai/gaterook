<?xml version="1.0" encoding="UTF-8"?>
<!--
  Trino and Presto (docs/trino.md): catalogs, schemas, tables and SQL reads, one approved change per call. Trino's
  client protocol (POST /v1/statement, nextUri) over java.net.http; Trino's own EXPLAIN (TYPE IO, FORMAT JSON) decides
  whether a statement reads before it runs. No Trino client library. Spring only in the .boot subpackage.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>connectors-trino</artifactId>
  <name>GateRook · Connectors · Trino</name>

  <dependencies>
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>connector-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>connectors-support</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- HttpUrl of the support module's URL rules, which read the coordinator's address. -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp-jvm</artifactId>
    </dependency>

    <!-- Registration of the built-in beans, .boot subpackage only (ARCHITECTURE.md §2.3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- *IT with -Ptrino-it (tag trino-it): Trino 484 of the Compose services (-Pservices, profile trino). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
