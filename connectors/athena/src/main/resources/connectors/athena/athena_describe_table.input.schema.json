{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "table"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "table": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "database.table, catalog.database.table, or a table of the default database."
    }
  }
}
