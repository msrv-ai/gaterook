      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          }
        }
      }
    },
    "contentType": {
      "type": "string"
    },
    "size": {
      "type": "integer"
    },
    "lastModified": {
      "type": "string"
    },
