{
  "area": "azure",
  "module": "connectors/azure",
  "connectorTypes": ["azure"],
  "description": "Touches of the Azure connector for the native smoke: the call checks without I/O (an action that returns keys is denied, a KQL control command in Resource Graph is denied), and Test connection of an Azure CLI sign-in stops for the person's decision before anything runs (or fails where the CLI isn't installed). None needs a server.",
  "touches": [
    {
      "name": "secret-action-denied",
      "connection": {"type": "azure", "env": "dev",
        "config": {"tenantId": "6f1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d", "subscriptions": ["0b1f6471-1bf0-4dda-aec3-111122223333"], "credentials": {"source": "cli"}}},
      "call": {"tool": "azure_api_change", "arguments": {"method": "POST", "path": "/subscriptions/0b1f6471-1bf0-4dda-aec3-111122223333/resourceGroups/smoke/providers/Microsoft.Storage/storageAccounts/smoke/listKeys", "apiVersion": "2023-05-01"}},
      "expect": {"isError": true, "textStartsWith": "Denied by policy dev.cloud.azure_secret_action"}
    },
    {
      "name": "graph-command-denied",
      "connection": {"type": "azure", "env": "dev",
        "config": {"tenantId": "6f1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d", "subscriptions": ["0b1f6471-1bf0-4dda-aec3-111122223333"], "credentials": {"source": "cli"}}},
      "call": {"tool": "azure_describe", "arguments": {"query": ".show tables"}},
      "expect": {"isError": true, "textStartsWith": "Denied by policy dev.cloud.kql_command"}
    },
    {
      "name": "cli-asks-first",
      "connection": {"type": "azure", "env": "dev",
        "config": {"subscriptions": ["0b1f6471-1bf0-4dda-aec3-111122223333"], "credentials": {"source": "cli"}}},
      "test": true,
      "expect": {"ok": false}
    }
  ]
}
