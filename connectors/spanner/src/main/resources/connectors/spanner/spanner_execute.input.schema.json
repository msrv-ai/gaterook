{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "sql"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "sql": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "description": "One INSERT, UPDATE or DELETE, committed in its own transaction, or one CREATE, ALTER, DROP, RENAME or ANALYZE schema change. A person approves the exact text."
    },
    "parameters": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "type": {
            "enum": [
              "STRING",
              "INT64",
              "FLOAT64",
              "NUMERIC",
              "BOOL",
              "DATE",
              "TIMESTAMP",
              "BYTES",
              "JSON"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "description": "Values of the statement's parameters: @name in GoogleSQL; $1, $2 named p1, p2 in a PostgreSQL-dialect database. BYTES as base64."
    },
    "note": {
      "type": "string",
      "maxLength": 500,
      "description": "Why you need this change. Shown to the approver as unverified."
    }
  }
}
