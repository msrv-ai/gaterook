{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "sql"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "sql": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "description": "One query in the database's dialect: SELECT, WITH, GoogleSQL's FROM pipe syntax or GRAPH. It runs in a read-only transaction; the endpoint caps rows."
    },
    "parameters": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "type": {
            "enum": [
              "STRING",
              "INT64",
              "FLOAT64",
              "NUMERIC",
              "BOOL",
              "DATE",
              "TIMESTAMP",
              "BYTES",
              "JSON"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "description": "Values of the statement's parameters: @name in GoogleSQL; $1, $2 named p1, p2 in a PostgreSQL-dialect database. BYTES as base64."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 100,
      "description": "Most rows to return; the endpoint caps it."
    },
    "cursor": {
      "type": "string",
      "maxLength": 8192,
      "description": "nextCursor of the previous answer; leave it out for the first page."
    }
  }
}
