{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "project",
    "deployment",
    "action"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,57}$",
      "description": "The project's name."
    },
    "deployment": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "The deployment to retry, or the production deployment to roll back to."
    },
    "action": {
      "enum": [
        "retry",
        "rollback"
      ],
      "description": "retry builds and deploys the deployment again; rollback makes an earlier production deployment live."
    }
  }
}
