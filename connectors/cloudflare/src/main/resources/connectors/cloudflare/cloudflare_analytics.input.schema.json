{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "zone",
    "dataset"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "zone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "description": "A zone by name, such as example.com, or by its 32-character ID."
    },
    "dataset": {
      "enum": [
        "security_events",
        "security_summary",
        "http_requests"
      ],
      "description": "security_events: WAF and other security events, newest first; security_summary: their count by groupBy; http_requests: the zone's HTTP requests counted by groupBy."
    },
    "from": {
      "type": "string",
      "maxLength": 40,
      "description": "Start: -1h (default), -30m, -1d or an ISO time with an offset."
    },
    "to": {
      "type": "string",
      "maxLength": 40,
      "description": "End: now (default) or an ISO time with an offset."
    },
    "groupBy": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "action",
          "source",
          "ruleId",
          "clientCountryName",
          "clientIP",
          "clientRequestHTTPHost",
          "clientRequestPath",
          "clientRequestHTTPMethodName",
          "edgeResponseStatus",
          "cacheStatus",
          "originResponseStatus",
          "userAgent",
          "clientAsn"
        ]
      },
      "description": "Up to two dimensions to count by. Default: action and source for security_summary, edgeResponseStatus for http_requests."
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^[a-z_]{1,40}$",
          "description": "block, challenge, managed_challenge, js_challenge, log, skip, allow…"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-zA-Z_]{1,40}$",
          "description": "firewallManaged, firewallCustom, ratelimit, securitylevel, waf, botFight…"
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "clientIP": {
          "type": "string",
          "maxLength": 45,
          "pattern": "^[0-9A-Fa-f:.]{2,45}$"
        },
        "clientCountryName": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO country code, such as US."
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9.-]{1,253}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/"
        },
        "method": {
          "type": "string",
          "pattern": "^[A-Z]{3,10}$"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599,
          "description": "Edge response status."
        }
      },
      "description": "Only events or requests that match all of these."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 25,
      "description": "Most events or groups."
    }
  }
}
