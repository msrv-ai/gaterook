{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "view": {
      "enum": [
        "projects",
        "project",
        "deployments",
        "deployment",
        "logs"
      ],
      "default": "projects",
      "description": "projects of the account; one project; its deployments; one deployment; the build log of one deployment."
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,57}$",
      "description": "The project's name."
    },
    "deployment": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "A deployment ID."
    },
    "environment": {
      "enum": [
        "production",
        "preview"
      ],
      "description": "Only deployments of this environment."
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "Page of the list, from 1."
    },
    "perPage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25,
      "description": "Projects or deployments per page."
    }
  }
}
