<?xml version="1.0" encoding="UTF-8"?>
<!--
  InfluxDB (docs/influxdb.md): databases, measurements, and SQL or InfluxQL reads of InfluxDB 3 Core and Enterprise,
  InfluxDB 2.x and InfluxDB 1.x; one approved line protocol write per change. Their HTTP APIs over java.net.http,
  with the connection's token or password; no InfluxDB client library. Flux is not supported. Spring only in the
  .boot subpackage.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.msrv.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>connectors-influxdb</artifactId>
  <name>GateRook · Connectors · InfluxDB</name>

  <dependencies>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connector-api</artifactId>
    </dependency>
    <!-- UrlRules, AddressPolicy, OutputSanitizer, Pem, TrustStores, Glob; its OkHttp only parses the base URL. -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connectors-support</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Registration of the built-in bean, .boot subpackage only (ARCHITECTURE.md §2.3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        *IT with -Pservices,influxdb-it (tag influxdb-it): InfluxDB 3 Core and InfluxDB 2.9 of the Compose services
        (scripts/test-services.sh up influxdb). Every build runs the fakes of the three APIs (MockWebServer).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
