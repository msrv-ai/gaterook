{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "database"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "database": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "A database of the connection (a bucket on InfluxDB 2.x)."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 200,
      "description": "Most measurements to return."
    },
    "cursor": {
      "type": "string",
      "maxLength": 8192,
      "description": "nextCursor of the previous answer; leave it out for the first page."
    }
  }
}
