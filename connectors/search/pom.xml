<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vector databases and search engines (docs/vector-databases.md, docs/search-engines.md): Pinecone, Qdrant, Milvus and
  Zilliz Cloud, Weaviate and Chroma behind the vector_* tools; Algolia, Meilisearch, Typesense and Azure AI Search
  behind the search_* tools. Their REST APIs through the core's guarded egress, with no vendor SDK; reads run at once,
  every write and delete waits for approval. Spring only in the .boot subpackage.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.msrv.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>connectors-search</artifactId>
  <name>GateRook · Connectors · Vector databases and search engines</name>

  <dependencies>
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connector-api</artifactId>
    </dependency>
    <!-- EgressClients and GuardedEgress (the core's guard), UrlRules, AddressPolicy, Pem, Glob, OutputSanitizer. -->
    <dependency>
      <groupId>ai.msrv.gaterook</groupId>
      <artifactId>connectors-support</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Registration of the built-in beans, .boot subpackage only (ARCHITECTURE.md §2.3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        *IT with -Pservices,search-it (tag search-it): Qdrant, Milvus, Weaviate, Chroma, Pinecone Local, Meilisearch and
        Typesense of the Compose services (scripts/test-services.sh up search). Every build runs the fakes, Algolia's and
        Azure AI Search's among them (MockWebServer).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
