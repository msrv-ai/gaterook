{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "index",
    "ids"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "index": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "The index (a collection on Typesense). search_list_indexes lists them."
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": [
          "string",
          "integer"
        ],
        "description": "A document id: Algolia's objectID, Meilisearch's primary key, Typesense's id, Azure AI Search's key."
      },
      "description": "The documents to fetch."
    },
    "fields": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "description": "Only these fields of each document."
    }
  }
}
