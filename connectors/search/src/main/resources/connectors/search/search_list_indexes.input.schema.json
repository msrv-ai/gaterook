{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "like": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Only names that match, with * for any characters: products_*."
    }
  }
}
