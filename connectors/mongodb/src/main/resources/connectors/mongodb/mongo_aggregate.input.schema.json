{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "collection",
    "pipeline"
  ],
  "properties": {
    "connection": {
      "type": "string"
    },
    "database": {
      "type": "string",
      "maxLength": 64,
      "description": "Default: the database in the connection string."
    },
    "collection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "pipeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1
      },
      "description": "Stages in Extended JSON, each an object with one key: [{\"$match\":{…}},{\"$group\":{…}}]. $out, $merge and server-side JavaScript are refused."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 50
    }
  }
}
