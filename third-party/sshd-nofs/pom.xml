<?xml version="1.0" encoding="UTF-8"?>
<!--
  Apache MINA SSHD without its FileSystemProvider (report 15 §4, §8; ARCHITECTURE.md A23).

  sshd-common declares RootedFileSystemProvider in META-INF/services/java.nio.file.spi.FileSystemProvider. GraalVM 25
  instantiates installed file system providers at build time, and that object in the image heap fails the native
  build. The rooted FS is only used by the SFTP server, which we don't ship. This module re-packages sshd-core and
  sshd-common unchanged (no relocation) minus that service file.

  The originals are <optional>: Maven 3.9 doesn't hand the dependency-reduced POM to reactor siblings (MNG-5899),
  so non-optional originals would leak to connectors/ssh next to the shaded copy. connectors/ssh additionally
  excludes org.apache.sshd:*, and the ban-sshd enforcer execution of the root pom guards every other module.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.msrv.gaterook</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>sshd-nofs</artifactId>
  <name>MCP Gateway · Apache MINA SSHD without FileSystemProvider</name>

  <dependencies>
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-common</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- The one runtime dependency of the originals that consumers still need. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <!-- This is the module that is allowed to see the originals. -->
          <execution>
            <id>ban-sshd</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <!-- Rebuild the plain jar every time: otherwise an incremental build would shade the already-shaded jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration combine.self="override">
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
              <artifactSet>
                <includes>
                  <include>org.apache.sshd:sshd-core</include>
                  <include>org.apache.sshd:sshd-common</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>org.apache.sshd:sshd-common</artifact>
                  <excludes>
                    <exclude>META-INF/services/java.nio.file.spi.FileSystemProvider</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/DEPENDENCIES</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
